/* Dentro de Mí v2. Estilo juego: bordes gruesos, sombras duras, rebotes.
   Radios: tarjetas 22px, botones 16px, chips en pastilla. */
:root {
  --bg: #e9f5f0;
  --card: #ffffff;
  --card-2: #f3faf7;
  --ink: #10231e;
  --ink-2: #4a625c;
  --edge: #10231e;
  --pri: #19b394;
  --yellow: #ffd24a;
  --coral: #ff6a55;
  --sky: #4aa8ff;
  --teal: #19b394;
  --r-card: 22px;
  --r-btn: 16px;
  --shadow: 4px 4px 0 var(--edge);
  --shadow-sm: 2px 2px 0 var(--edge);
  --ease: cubic-bezier(.34, 1.56, .64, 1);
  --v4: #19b394; --v3: #8bc43f; --v2: #f2b21b; --v1: #f2762b; --v0: #e53b3b;
  --good: #19b394; --ok: #f2b21b; --bad: #e53b3b;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0c1815;
    --card: #15251f;
    --card-2: #1b2f28;
    --ink: #eaf5f1;
    --ink-2: #a6bdb6;
    --edge: #05100d;
    --shadow: 4px 4px 0 #000;
    --shadow-sm: 2px 2px 0 #000;
  }
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0; min-height: 100dvh; padding-bottom: 60px;
  background: var(--bg); color: var(--ink);
  font-family: "Outfit", system-ui, sans-serif; font-size: 17px; line-height: 1.5;
}
/* Fondo tipo lienzo: puntos + figuras variadas (estilo papel tapiz de chat) con los íconos de la historia. */
body { --wash: var(--yellow); --wash2: var(--sky); }
body[data-wash="coral"] { --wash: var(--coral); }
body[data-wash="sky"] { --wash: var(--sky); }
body[data-wash="yellow"] { --wash: #e0a800; }
body[data-wash="teal"] { --wash: var(--teal); }
body[data-wash="ink"] { --wash: #6f8f86; }
#doodle { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; color: color-mix(in srgb, var(--wash) 55%, var(--ink)); opacity: .18; transition: color .8s; }
#doodle i { position: absolute; line-height: 1; }
@media (prefers-color-scheme: dark) { #doodle { opacity: .2; } }

h1, h2, h3, .display { font-family: "Fredoka", "Outfit", sans-serif; line-height: 1.05; letter-spacing: -.01em; margin: 0; font-weight: 600; }
p { margin: 0; }
a { color: inherit; }
i { line-height: 1; }
:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; border-radius: 8px; }
main { max-width: 1180px; margin: 0 auto; padding: clamp(20px, 4vw, 44px) clamp(14px, 4vw, 36px); outline: none; }
[hidden] { display: none !important; }
main:focus, main:focus-visible { outline: none; }

/* Barra superior */
.top { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 10px; height: 64px; padding: 0 clamp(12px, 3vw, 32px); background: var(--bg); border-bottom: 3px solid var(--edge); }
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: "Fredoka", sans-serif; font-weight: 700; font-size: 1.35rem; }
.brand-mark { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; background: var(--yellow); color: #10231e; border: 2.5px solid var(--edge); box-shadow: var(--shadow-sm); font-size: 1.2rem; }
.top-nav { display: flex; gap: 8px; }
.top-nav a, .top-nav button { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; border: 2.5px solid var(--edge); border-radius: 14px; background: var(--card); color: var(--ink); font: inherit; font-size: .9rem; font-weight: 500; text-decoration: none; cursor: pointer; box-shadow: var(--shadow-sm); transition: transform .15s, box-shadow .15s; }
.top-nav a:hover, .top-nav button:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 var(--edge); }
.top-nav a:active, .top-nav button:active { transform: translate(2px, 2px); box-shadow: 0 0 0 var(--edge); }
.top-nav a[aria-current="page"], .top-nav button[aria-pressed="true"] { background: var(--yellow); color: #10231e; }
@media (max-width: 760px) { .top-nav a span, .top-nav button span { display: none; } .top-nav a, .top-nav button { padding: 0 12px; } .brand-name { font-size: 1.15rem; } }

/* Ayuda fija */
.help { position: fixed; inset: auto 0 0 0; z-index: 30; height: 48px; display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; overflow: hidden; background: var(--ink); color: var(--bg); font-size: .9rem; padding: 0 12px; border-top: 3px solid var(--edge); }
.help i { font-size: 1.2rem; }
.help-sep { width: 1px; height: 16px; background: currentColor; opacity: .4; }

/* Botones */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 0 26px; border: 3px solid var(--edge); border-radius: var(--r-btn); font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 1.1rem; color: #10231e; cursor: pointer; text-decoration: none; white-space: nowrap; box-shadow: var(--shadow); transition: transform .15s, box-shadow .15s; }
.btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--edge); }
.btn:active { transform: translate(3px, 3px); box-shadow: 0 0 0 var(--edge); }
.btn-pri { background: var(--yellow); }
.btn-go { background: var(--pri); }
.btn-ghost { background: var(--card); color: var(--ink); }
.btn-sm { min-height: 44px; padding: 0 18px; font-size: 1rem; }

.kicker { display: inline-flex; align-items: center; gap: 8px; padding: 5px 14px; border: 2.5px solid var(--edge); border-radius: 999px; background: var(--card); font-weight: 600; font-size: .85rem; box-shadow: var(--shadow-sm); }
.card { background: var(--card); border: 3px solid var(--edge); border-radius: var(--r-card); box-shadow: var(--shadow); }

/* Inicio */
.home { display: grid; gap: 36px; align-items: center; padding: clamp(8px, 3vw, 30px) 0 20px; }
@media (min-width: 900px) { .home { grid-template-columns: 1.1fr .9fr; } }
.home h1 { font-size: clamp(3rem, 8vw, 5.6rem); margin: 18px 0 14px; }
.home h1 em { font-style: normal; color: #10231e; background: var(--yellow); padding: 0 .15em; border-radius: 14px; border: 3px solid var(--edge); display: inline-block; transform: rotate(-2deg); box-shadow: var(--shadow); }
.lead { font-size: 1.2rem; color: var(--ink-2); max-width: 36ch; }
.start-form { margin-top: 28px; display: grid; gap: 18px; max-width: 460px; }
.field label, .field .lbl { display: block; font-weight: 600; margin-bottom: 8px; }
.field input { width: 100%; min-height: 54px; padding: 0 16px; border: 3px solid var(--edge); border-radius: var(--r-btn); background: var(--card); color: var(--ink); font: inherit; font-size: 1.1rem; }
.field input::placeholder { color: var(--ink-2); }
.avs { display: flex; gap: 10px; }
.av { width: 64px; height: 64px; padding: 0; border: 3px solid var(--edge); border-radius: 18px; background: var(--card); cursor: pointer; overflow: hidden; transition: transform .2s var(--ease); }
.av:hover { transform: translateY(-3px); }
.av[aria-checked="true"] { background: var(--yellow); box-shadow: var(--shadow-sm); transform: translateY(-3px) rotate(-3deg); }
.av svg { width: 100%; height: 100%; }
.home-art { position: relative; display: grid; place-items: center; min-height: 340px; border: 3px solid var(--edge); border-radius: 32px; background: radial-gradient(90% 90% at 30% 20%, var(--yellow), transparent 60%), var(--card-2); box-shadow: var(--shadow); overflow: hidden; }
.home-art .port { width: min(250px, 60%); }
.float { position: absolute; display: flex; align-items: center; gap: 8px; padding: 8px 12px; border: 2.5px solid var(--edge); border-radius: 14px; background: var(--card); font-weight: 600; font-size: .85rem; box-shadow: var(--shadow-sm); }
.float i { font-size: 1.2rem; }
.float.f1 { top: 12%; left: 6%; } .float.f2 { top: 22%; right: 6%; } .float.f3 { bottom: 14%; left: 8%; }
.steps { display: grid; gap: 16px; margin-top: 30px; }
@media (min-width: 760px) { .steps { grid-template-columns: repeat(3, 1fr); } }
.step { padding: 20px; display: grid; gap: 8px; }
.step i { font-size: 2rem; }
.step h3 { font-size: 1.3rem; }
.step p { color: var(--ink-2); font-size: .95rem; }

/* Casos */
.page-head { margin-bottom: 22px; }
.page-head h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
.page-head p { color: var(--ink-2); margin-top: 8px; max-width: 52ch; }
.chips { display: flex; flex-wrap: wrap; gap: 10px; margin: 18px 0 26px; }
.chip { min-height: 44px; padding: 0 18px; border: 2.5px solid var(--edge); border-radius: 999px; background: var(--card); color: var(--ink); font: inherit; font-weight: 500; cursor: pointer; box-shadow: var(--shadow-sm); transition: transform .15s; }
.chip:hover { transform: translateY(-2px); }
.chip[aria-pressed="true"] { background: var(--yellow); color: #10231e; font-weight: 600; }
.grid { display: grid; gap: 22px; grid-template-columns: 1fr; }
@media (min-width: 720px) { .grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1040px) { .grid { grid-template-columns: repeat(3, 1fr); } .grid .case:first-child { grid-column: span 2; } }
.case { position: relative; display: flex; flex-direction: column; overflow: hidden; background: var(--card); border: 3px solid var(--edge); border-radius: var(--r-card); box-shadow: var(--shadow); transition: transform .25s var(--ease), box-shadow .2s; }
.case:hover { transform: translate(-3px, -3px) rotate(-.4deg); box-shadow: 7px 7px 0 var(--edge); }
.case-top { display: flex; align-items: flex-end; justify-content: space-between; min-height: 130px; padding: 18px; border-bottom: 3px solid var(--edge); background: var(--c); }
.case-top .big { display: grid; place-items: center; width: 72px; height: 72px; border: 3px solid var(--edge); border-radius: 20px; background: var(--card); color: var(--ink); font-size: 2.2rem; box-shadow: var(--shadow-sm); transform: rotate(-4deg); }
.tagpill { padding: 4px 12px; border: 2.5px solid var(--edge); border-radius: 999px; background: var(--card); color: var(--ink); font-weight: 600; font-size: .8rem; }
.case-body { display: flex; flex-direction: column; gap: 12px; padding: 18px; flex: 1; }
.case-body h2 { font-size: 1.6rem; }
.case-body p { color: var(--ink-2); font-size: .96rem; }
.case-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-top: auto; padding-top: 6px; }
.ends { display: inline-flex; gap: 6px; align-items: center; font-size: .85rem; color: var(--ink-2); }
.dot { width: 14px; height: 14px; border-radius: 50%; border: 2.5px solid var(--edge); background: var(--card-2); }
.dot.on.good { background: var(--good); } .dot.on.ok { background: var(--ok); } .dot.on.bad { background: var(--bad); }
.case-btns { display: flex; gap: 8px; }
.cc-yellow { --c: var(--yellow); } .cc-coral { --c: var(--coral); } .cc-sky { --c: var(--sky); } .cc-teal { --c: var(--teal); } .cc-ink { --c: #6f8f86; }

/* Intro de caso */
.crumbs { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 18px; font-size: .92rem; color: var(--ink-2); }
.crumbs a { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--ink); }
.intro { display: grid; gap: 24px; }
@media (min-width: 900px) { .intro { grid-template-columns: 1.2fr .8fr; align-items: start; } }
.intro-main { overflow: hidden; }
.intro-main .case-top { min-height: 150px; }
.intro-main .body { padding: 24px; display: grid; gap: 16px; }
.intro-main h1 { font-size: clamp(2rem, 4.5vw, 3rem); }
.intro-main .story { font-size: 1.2rem; }
.cast { display: grid; gap: 10px; }
.cast-row { display: flex; align-items: center; gap: 12px; }
.cast-ini { display: grid; place-items: center; width: 42px; height: 42px; border: 2.5px solid var(--edge); border-radius: 50%; background: var(--yellow); color: #10231e; font-family: "Fredoka", sans-serif; font-weight: 700; flex: none; }
.cast-row span { color: var(--ink-2); font-size: .92rem; }
.side { padding: 20px; display: grid; gap: 12px; }
.side h2 { font-size: 1.3rem; }
.scene-btn { text-decoration: none; display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; min-height: 54px; padding: 0 16px; border: 2.5px solid var(--edge); border-radius: 14px; background: var(--card-2); color: var(--ink); font: inherit; font-weight: 600; text-align: left; cursor: pointer; transition: transform .15s; }
.scene-btn:hover { transform: translateX(4px); background: var(--yellow); color: #10231e; }
.scene-btn .n { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--ink); color: var(--bg); font-size: .8rem; margin-right: 10px; flex: none; }
.scene-btn > span:first-child { display: flex; align-items: center; }

/* Final */
.end { overflow: hidden; animation: pop-in .6s var(--ease) both; }
.end-head { padding: 24px; border-bottom: 3px solid var(--edge); display: grid; gap: 10px; }
.end-head.good { background: var(--good); color: #04261f; } .end-head.ok { background: var(--ok); color: #2b2100; } .end-head.bad { background: var(--bad); color: #fff; }
.end-badge { display: inline-flex; align-items: center; gap: 8px; width: fit-content; padding: 5px 14px; border: 2.5px solid var(--edge); border-radius: 999px; background: var(--card); color: var(--ink); font-weight: 600; font-size: .9rem; }
.end-head h2 { font-size: clamp(2rem, 5vw, 3rem); }
.end-body { padding: 24px; display: grid; gap: 20px; }
.end-body h3 { font-size: 1.15rem; margin-bottom: 8px; display: flex; align-items: center; gap: 10px; }
.end-body h3 i { font-size: 1.5rem; }
.end-body p + p { margin-top: 8px; }
.tip { padding: 16px 18px; border: 3px dashed var(--edge); border-radius: var(--r-card); background: var(--card-2); }
.sumrow { display: flex; flex-wrap: wrap; gap: 10px; }
.sumpill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border: 2.5px solid var(--edge); border-radius: 999px; background: var(--card-2); font-weight: 600; font-size: .92rem; }
.end-actions { display: flex; flex-wrap: wrap; gap: 12px; }

/* Guía */
.sheets { display: grid; gap: 18px; grid-template-columns: 1fr; }
@media (min-width: 720px) { .sheets { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1040px) { .sheets { grid-template-columns: repeat(3, 1fr); } }
.sheet-card { display: flex; align-items: center; gap: 16px; padding: 18px; text-decoration: none; transition: transform .2s var(--ease); }
.sheet-card:hover { transform: translate(-3px, -3px) rotate(-.5deg); }
.sheet-card .big { display: grid; place-items: center; width: 60px; height: 60px; border: 3px solid var(--edge); border-radius: 18px; background: var(--yellow); color: #10231e; font-size: 1.9rem; flex: none; }
.sheet-card h2 { font-size: 1.4rem; }
.sheet-card p { color: var(--ink-2); font-size: .9rem; }
.sheet { padding: 0; overflow: hidden; }
.sheet-head { display: flex; align-items: center; gap: 16px; padding: 20px 24px; background: var(--yellow); color: #10231e; border-bottom: 3px solid var(--edge); }
.sheet-head .big { display: grid; place-items: center; width: 64px; height: 64px; border: 3px solid var(--edge); border-radius: 18px; background: #fff; font-size: 2rem; }
.sheet-head h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); }
.sec { border-bottom: 3px solid var(--edge); }
.sec:last-child { border-bottom: 0; }
.sec summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 60px; padding: 0 24px; cursor: pointer; font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 1.2rem; list-style: none; }
.sec summary::-webkit-details-marker { display: none; }
.sec summary i { transition: transform .25s var(--ease); }
.sec[open] summary i { transform: rotate(180deg); }
.sec .in { padding: 0 24px 22px; display: grid; gap: 10px; }
.sec.urgent { background: color-mix(in srgb, var(--bad) 14%, var(--card)); }
.myth { display: grid; gap: 4px; padding: 12px 14px; border: 2.5px solid var(--edge); border-radius: 14px; background: var(--card-2); }
.myth .m { font-weight: 600; } .myth .m i { color: var(--bad); margin-right: 6px; } .myth .r i { color: var(--good); margin-right: 6px; }
.myth .r { color: var(--ink-2); }

#toasts { position: fixed; z-index: 40; right: 14px; bottom: 62px; display: grid; gap: 8px; pointer-events: none; }
.toast { padding: 10px 16px; border: 3px solid var(--edge); border-radius: 14px; background: var(--yellow); color: #10231e; font-family: "Fredoka", sans-serif; font-weight: 600; box-shadow: var(--shadow); animation: toast 2.2s ease forwards; }

/* Juego: usuario a la izquierda, personaje de la historia a la derecha. */
.play { display: grid; gap: 18px; }
@media (min-width: 960px) { .play { grid-template-columns: 320px minmax(0, 1fr); align-items: start; } .you { grid-row: span 2; position: sticky; top: 84px; } }
.play-bar { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
.back { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; text-decoration: none; }
.back:hover { text-decoration: underline; }
.score { display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; border: 3px solid var(--edge); border-radius: 999px; background: var(--card); font-family: "Fredoka", sans-serif; font-weight: 600; box-shadow: var(--shadow-sm); }
.score i { color: var(--coral); font-size: 1.3rem; }
.score.bump { animation: bump .5s var(--ease); }

.you { padding: 16px; display: grid; gap: 12px; }
.you-head { display: flex; align-items: center; gap: 14px; }
.you-head .port { width: 92px; flex: none; }
.role { display: inline-block; padding: 1px 10px; border: 2px solid var(--edge); border-radius: 999px; background: var(--yellow); color: #10231e; font-weight: 600; font-size: .72rem; margin-bottom: 4px; }
.who { font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 1.3rem; line-height: 1.1; }
.mood { color: var(--ink-2); font-size: .88rem; }
.note-you { color: var(--ink-2); font-size: .92rem; padding: 10px 12px; border: 2.5px dashed var(--edge); border-radius: 14px; }
.tiles { display: grid; gap: 8px; grid-template-columns: repeat(2, 1fr); }
@media (min-width: 960px) { .you .tiles { grid-template-columns: 1fr; } }
.tile { position: relative; display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 4px 10px; align-items: center; width: 100%; padding: 8px 10px; border: 2.5px solid var(--edge); border-radius: 14px; background: var(--card-2); color: var(--ink); font: inherit; text-align: left; cursor: pointer; transition: transform .15s; }
.tile:hover { transform: translateY(-2px); background: var(--card); }
.tile i.ic { grid-row: span 3; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--card); border: 2px solid var(--edge); font-size: 1.2rem; }
.tile .nm { font-weight: 600; font-size: .85rem; line-height: 1.1; }
.cells { display: flex; gap: 3px; }
.cells span { flex: 1; height: 10px; border: 2px solid var(--edge); border-radius: 4px; background: var(--card); transition: background .5s; }
.tile .lab { font-size: .75rem; color: var(--ink-2); line-height: 1; }
.tile.v4 .cells span.on { background: var(--v4); } .tile.v3 .cells span.on { background: var(--v3); }
.tile.v2 .cells span.on { background: var(--v2); } .tile.v1 .cells span.on { background: var(--v1); } .tile.v0 .cells span.on { background: var(--v0); }
.tile.v0, .tile.v1 { border-color: var(--v0); }
.tile.dn { animation: shake .5s; } .tile.up { animation: bump .5s var(--ease); }
.tiles-hint { font-size: .78rem; color: var(--ink-2); }
.pop { position: absolute; right: 8px; top: -10px; padding: 2px 10px; border: 2.5px solid var(--edge); border-radius: 999px; font-family: "Fredoka", sans-serif; font-weight: 700; font-size: .85rem; color: #10231e; animation: floatup 1.4s ease forwards; }
.pop.dn { background: var(--coral); } .pop.up { background: var(--v3); }

/* Escena del personaje */
.scene { overflow: hidden; }
.scene-bg { position: relative; display: flex; align-items: flex-end; justify-content: flex-end; min-height: 250px; padding: 0 clamp(14px, 6vw, 56px); border-bottom: 3px solid var(--edge); overflow: hidden; background: linear-gradient(180deg, #1c3a4a, #14262f); }
.scene-bg::before { content: ""; position: absolute; inset: 0; pointer-events: none; }
.npc-tag { position: absolute; z-index: 2; top: 14px; left: 14px; max-width: 60%; padding: 8px 14px; border: 2.5px solid var(--edge); border-radius: 14px; background: var(--card); box-shadow: var(--shadow-sm); }
.npc-tag b { display: block; font-family: "Fredoka", sans-serif; font-size: 1.15rem; line-height: 1.1; }
.npc-tag small { color: var(--ink-2); font-size: .8rem; }
.npc-mood { position: absolute; z-index: 2; left: 14px; bottom: 14px; display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border: 2.5px solid var(--edge); border-radius: 999px; background: var(--yellow); color: #10231e; font-weight: 600; font-size: .8rem; box-shadow: var(--shadow-sm); }
.npc { position: relative; z-index: 1; width: min(230px, 44%); margin-bottom: -6px; transform-origin: 50% 100%; }
.npc .port { width: 100%; display: block; }
.npc.swap { animation: pop-in .5s var(--ease) both; }
.talk { padding: 18px; display: grid; gap: 12px; }
.you-echo { display: flex; align-items: center; gap: 10px; width: fit-content; max-width: 100%; padding: 5px 14px 5px 6px; border: 2.5px dashed var(--edge); border-radius: 999px; background: var(--card-2); font-weight: 600; font-size: .9rem; }

.nar { padding: 14px 16px; border: 3px solid var(--edge); border-radius: 16px; background: var(--card-2); font-size: 1.1rem; animation: pop-in .45s var(--ease) both; }
.say { display: flex; gap: 12px; align-items: flex-start; animation: pop-in .45s var(--ease) both; }
.say .cast-ini { margin-top: 2px; }
.say .bub { position: relative; padding: 12px 16px; border: 3px solid var(--edge); border-radius: 6px 22px 22px 22px; background: var(--yellow); color: #10231e; font-size: 1.12rem; box-shadow: var(--shadow-sm); }
.say .bub b { display: block; font-family: "Fredoka", sans-serif; font-size: .8rem; letter-spacing: .02em; margin-bottom: 2px; opacity: .75; }
.skip-hint { color: var(--ink-2); font-size: .85rem; }
.npc-stats { padding: 14px 18px 0; display: grid; gap: 8px; }
.npc-stats .tiles { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }

/* Fondos de escena: identidad por caso, solo con CSS */
.scene-bg[data-scene="llaves"] { background:
  radial-gradient(circle at 10% 16%, #ffd24a 0 3px, transparent 4px), radial-gradient(circle at 24% 9%, #ff6a55 0 3px, transparent 4px), radial-gradient(circle at 40% 15%, #ffd24a 0 3px, transparent 4px), radial-gradient(circle at 56% 8%, #4aa8ff 0 3px, transparent 4px), radial-gradient(circle at 72% 14%, #ffd24a 0 3px, transparent 4px),
  radial-gradient(60% 70% at 78% 100%, rgba(255, 210, 74, .22), transparent 70%), linear-gradient(180deg, #0e2236, #1c4a5c); }
.scene-bg[data-scene="llaves"]::before { background:
  radial-gradient(circle at 20px 20px, #ffd24a 0 2px, transparent 3px) 14px 26px / 26px 30px,
  linear-gradient(#081826, #081826) 0 100% / 70px 120px no-repeat, linear-gradient(#0a1d2e, #0a1d2e) 82px 100% / 56px 160px no-repeat, linear-gradient(#081826, #081826) 150px 100% / 80px 100px no-repeat, linear-gradient(#0a1d2e, #0a1d2e) 242px 100% / 50px 140px no-repeat; opacity: .9; }
.scene-bg[data-scene="examen"] { background: radial-gradient(45% 70% at 18% 72%, rgba(255, 210, 74, .55), transparent 70%), linear-gradient(180deg, #17294a, #0f1a30); }
.scene-bg[data-scene="examen"]::before { background: linear-gradient(#3a2a1e, #3a2a1e) 0 100% / 100% 46px no-repeat, linear-gradient(#ffd24a, #ffd24a) 40px calc(100% - 46px) / 10px 70px no-repeat, linear-gradient(#ffd24a, #ffd24a) 28px calc(100% - 112px) / 44px 8px no-repeat; }
.scene-bg[data-scene="vapeo"] { background: linear-gradient(180deg, #cfe8f5, #e4f3ee); }
.scene-bg[data-scene="vapeo"]::before { background: repeating-linear-gradient(90deg, #6fa8c9 0 66px, #4f89ad 66px 70px) 0 100% / 100% 64% no-repeat, linear-gradient(#10231e, #10231e) 0 100% / 100% 12px no-repeat; opacity: .85; }
.scene-bg[data-scene="pastillas"] { background: linear-gradient(180deg, #0f2a24, #143a31); }
.scene-bg[data-scene="pastillas"]::before { background: repeating-linear-gradient(90deg, #ff6a55 0 10px, transparent 10px 14px, #ffd24a 14px 22px, transparent 22px 26px, #4aa8ff 26px 33px, transparent 33px 38px, #19b394 38px 46px, transparent 46px 52px) 0 28px / 70% 44px no-repeat, repeating-linear-gradient(0deg, #0a1f1a 0 8px, transparent 8px 70px) 0 0 / 70% 100% no-repeat; opacity: .75; }
.scene-bg[data-scene="sofi"] { background: radial-gradient(45% 60% at 14% 40%, rgba(255, 196, 120, .4), transparent 70%), linear-gradient(180deg, #2a2020, #1b2a33); }
.scene-bg[data-scene="sofi"]::before { background: linear-gradient(#3b4250, #3b4250) 4% 100% / 80% 74px no-repeat, linear-gradient(#ffd24a, #ffd24a) 9% calc(100% - 90px) / 6px 80px no-repeat; border-radius: 0; }

/* Debajo de la escena: objetos, datos, decisiones */
.under { display: grid; gap: 16px; align-content: start; }
.objs-h { font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 1.05rem; display: flex; align-items: center; gap: 8px; }
.objs { display: flex; flex-wrap: wrap; gap: 10px; }
.obj { position: relative; display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 16px; border: 3px solid var(--edge); border-radius: 16px; background: var(--card); color: var(--ink); font: inherit; font-weight: 600; cursor: pointer; box-shadow: var(--shadow-sm); transition: transform .15s, box-shadow .15s, background .15s; }
.obj i { font-size: 1.3rem; }
.obj:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 var(--edge); background: var(--yellow); color: #10231e; }
.obj:active { transform: translate(2px, 2px); box-shadow: 0 0 0 var(--edge); }
.obj.seen { background: var(--card-2); }
.obj:not(.seen)::after { content: ""; position: absolute; inset: -6px; border: 2.5px solid var(--yellow); border-radius: 20px; opacity: 0; animation: ping 2.2s ease-out infinite; pointer-events: none; }
@keyframes ping { 0% { opacity: .9; transform: scale(.94); } 100% { opacity: 0; transform: scale(1.08); } }

.fact { padding: 0; border: 3px solid var(--edge); border-radius: var(--r-card); background: var(--sky); color: #10231e; box-shadow: var(--shadow); overflow: hidden; animation: pop-in .5s var(--ease) both; }
.fact-h { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 3px solid var(--edge); font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 1.15rem; }
.fact-h i { display: grid; place-items: center; width: 34px; height: 34px; border: 2.5px solid var(--edge); border-radius: 11px; background: #fff; font-size: 1.2rem; flex: none; }
.frow { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 12px; padding: 12px 16px; background: #fff; border-bottom: 2.5px solid var(--edge); }
.frow:last-of-type { border-bottom: 0; }
.frow .lb { display: inline-flex; align-items: center; gap: 6px; font-family: "Fredoka", sans-serif; font-weight: 600; font-size: .85rem; text-transform: uppercase; letter-spacing: .03em; }
.frow .lb i { font-size: 1.1rem; }
.frow.fx { background: #fff7d6; }
.frow p { font-size: 1.03rem; }
.fact-f { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 16px; align-items: center; }
.chipbtn { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 12px; border: 2.5px solid var(--edge); border-radius: 999px; background: #fff; color: #10231e; font: inherit; font-weight: 600; font-size: .85rem; cursor: pointer; transition: transform .15s; }
.chipbtn:hover { transform: translateY(-2px); background: var(--yellow); }
.more { padding: 0 16px 14px; background: var(--sky); font-size: .95rem; }

.turn { display: flex; align-items: center; gap: 12px; font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 1.1rem; }

.choices { display: grid; gap: 12px; }
.choice { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 14px; align-items: center; width: 100%; min-height: 66px; padding: 12px 16px; border: 3px solid var(--edge); border-radius: var(--r-card); background: var(--card); color: var(--ink); font: inherit; font-size: 1.08rem; font-weight: 500; text-align: left; cursor: pointer; box-shadow: var(--shadow); animation: pop-in .45s var(--ease) both; animation-delay: calc(var(--i, 0) * 80ms); transition: transform .15s, box-shadow .15s, background .15s; }
.choice:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--edge); background: var(--yellow); color: #10231e; }
.choice:active { transform: translate(3px, 3px); box-shadow: 0 0 0 var(--edge); }
.choice .k { display: grid; place-items: center; width: 40px; height: 40px; border: 2.5px solid var(--edge); border-radius: 12px; background: var(--card-2); color: var(--ink); font-family: "Fredoka", sans-serif; font-weight: 700; }
.choice:hover .k { background: #fff; color: #10231e; }
.nextbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

/* Hoja inferior: objetos, barras y fuentes */
.peek { position: fixed; z-index: 45; left: 50%; bottom: 60px; width: min(580px, calc(100% - 24px)); transform: translateX(-50%); border: 3px solid var(--edge); border-radius: var(--r-card); background: var(--card); box-shadow: 6px 6px 0 var(--edge); overflow: hidden; animation: sheet .35s var(--ease) both; }
.peek-h { display: flex; align-items: center; gap: 12px; padding: 12px 14px 12px 16px; border-bottom: 3px solid var(--edge); background: var(--yellow); color: #10231e; font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 1.15rem; }
.peek-h i.ic { font-size: 1.5rem; }
.peek-h .x { margin-left: auto; display: grid; place-items: center; width: 40px; height: 40px; border: 2.5px solid var(--edge); border-radius: 12px; background: #fff; color: #10231e; cursor: pointer; font-size: 1.1rem; }
.peek .frow { background: var(--card); } .peek .frow.fx { background: color-mix(in srgb, var(--yellow) 30%, var(--card)); }
.peek .foot { padding: 10px 16px 14px; color: var(--ink-2); font-size: .85rem; }
@keyframes sheet { from { opacity: 0; transform: translate(-50%, 24px); } to { opacity: 1; transform: translate(-50%, 0); } }

/* Retratos */
.port .skin { fill: var(--skin, #f1c9a5); } .port .shirt { fill: var(--shirt, #19b394); } .port .hair { fill: var(--hairc, #3b2f2a); }
.port .ink { fill: #1d2a26; } .port .white { fill: #fff; } .port .cheek { fill: #e9967a; opacity: .45; }
.port .ln { fill: none; stroke: #10231e; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
.port .thin { fill: none; stroke: #1d2a26; stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; }
.port .out { stroke: #10231e; stroke-width: 4; stroke-linejoin: round; }
.port .glass { fill: rgba(255, 255, 255, .25); stroke: #10231e; stroke-width: 3.5; }
.port .drop { fill: #7fd4ff; stroke: #10231e; stroke-width: 2; }
.port .patch { fill: #fff; stroke: #10231e; stroke-width: 2.5; }

/* Movimiento: cada animación cuenta algo. */
@keyframes pop-in { from { opacity: 0; transform: translateY(14px) scale(.96); } to { opacity: 1; transform: none; } }
@keyframes bump { 0% { transform: scale(1); } 40% { transform: scale(1.08) rotate(-1deg); } 100% { transform: scale(1); } }
@keyframes shake { 0%, 100% { transform: translateX(0); } 20% { transform: translateX(-6px); } 40% { transform: translateX(6px); } 60% { transform: translateX(-4px); } 80% { transform: translateX(3px); } }
@keyframes floatup { 0% { opacity: 0; transform: translateY(8px); } 15% { opacity: 1; } 100% { opacity: 0; transform: translateY(-24px); } }
@keyframes toast { 0% { opacity: 0; transform: translateY(10px); } 12%, 80% { opacity: 1; transform: none; } 100% { opacity: 0; transform: translateY(-8px); } }
@keyframes breathe { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
@keyframes sway { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }
@keyframes tremble { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-2px); } 75% { transform: translateX(2px); } }
@keyframes nod { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(4deg) translateY(4px); } }
body:not(.reduce) .port.m-calm, body:not(.reduce) .port.m-happy, body:not(.reduce) .port.m-proud { animation: breathe 4s ease-in-out infinite; }
body:not(.reduce) .port.m-tipsy { animation: sway 2.6s ease-in-out infinite; transform-origin: 50% 100%; }
body:not(.reduce) .port.m-scared, body:not(.reduce) .port.m-worried { animation: tremble .35s linear infinite; }
body:not(.reduce) .port.m-sleepy, body:not(.reduce) .port.m-out { animation: nod 4.5s ease-in-out infinite; transform-origin: 50% 100%; }
body:not(.reduce) .float { animation: breathe 3.6s ease-in-out infinite; }
body:not(.reduce) .float.f2 { animation-delay: -1.2s; } body:not(.reduce) .float.f3 { animation-delay: -2.4s; }
body.reduce *, body.reduce *::before, body.reduce *::after { animation: none !important; transition-duration: .01ms !important; }
@media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } html { scroll-behavior: auto; } }

.cast-av { --s: 46px; display: block; flex: none; width: var(--s); height: var(--s); border: 2.5px solid var(--edge); border-radius: 50%; background: var(--yellow); overflow: hidden; }
.cast-av .port { display: block; width: 138%; margin: calc(var(--s) * -.16) 0 0 -19%; }
.you-echo .cast-av { --s: 30px; } .turn .cast-av { --s: 44px; } .say .cast-av { margin-top: 2px; }
body:not(.reduce) .cast-av .port { animation: none; }

.scene, .under { scroll-margin-top: 78px; }

/* Mochila: los objetos se suman a medida que aparecen en las etapas */
.inv { display: grid; gap: 8px; padding-top: 4px; border-top: 3px dashed var(--edge); }
.inv-h { display: flex; align-items: center; gap: 8px; font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 1.05rem; padding-top: 10px; }
.inv-n { margin-left: auto; min-width: 26px; padding: 0 8px; text-align: center; border: 2.5px solid var(--edge); border-radius: 999px; background: var(--yellow); color: #10231e; font-size: .85rem; }
.inv-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.inv-empty { color: var(--ink-2); font-size: .88rem; }
.inv .obj { min-height: 42px; padding: 0 12px; font-size: .88rem; gap: 6px; }
.inv .obj i { font-size: 1.15rem; }
.obj.new { animation: pop-in .5s var(--ease) both; }
.obj.new::before { content: "nuevo"; position: absolute; top: -9px; right: -6px; padding: 0 7px; border: 2px solid var(--edge); border-radius: 999px; background: var(--coral); color: #10231e; font-size: .62rem; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; z-index: 1; }

/* Contexto = referencia + resumen */
.refbtn { display: flex; align-items: flex-start; gap: 10px; width: 100%; padding: 8px 10px; margin-bottom: 8px; border: 2.5px solid var(--edge); border-radius: 12px; background: var(--card-2); color: #10231e; font: inherit; text-align: left; cursor: pointer; transition: transform .15s, background .15s; }
.refbtn:hover { transform: translateX(3px); background: var(--yellow); }
.refbtn i { font-size: 1.2rem; margin-top: 1px; flex: none; }
.refbtn b { display: block; font-family: "Fredoka", sans-serif; font-size: .95rem; line-height: 1.1; }
.refbtn small { display: block; font-size: .78rem; opacity: .8; line-height: 1.25; }
.sum b { font-family: "Fredoka", sans-serif; font-size: .8rem; text-transform: uppercase; letter-spacing: .03em; margin-right: 4px; }
.frow .ctxcol { min-width: 0; }
