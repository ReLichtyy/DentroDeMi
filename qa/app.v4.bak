// Dentro de Mí v3: tú a la izquierda, el personaje de la historia a la derecha.
// Contexto y efecto en vez de explicaciones largas, y objetos, barras y fuentes tocables.
(function () {
  const $app = document.getElementById("app");
  const $toasts = document.getElementById("toasts");
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const store = {
    get(k, d) { try { const v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } },
    set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { /* sin almacenamiento */ } },
  };
  const S = {
    name: store.get("dm2-name", ""),
    av: store.get("dm2-av", 0),
    prog: store.get("dm2-prog", {}),
    reduce: store.get("dm2-reduce", false),
    snd: store.get("dm2-snd", 0),
  };
  const save = () => { store.set("dm2-name", S.name); store.set("dm2-av", S.av); store.set("dm2-prog", S.prog); };
  const me = () => S.name || "tú";
  const fill = (s) => s.replace(/\{yo\}/g, me());
  const caseOf = (id) => CASES.find((c) => c.id === id);
  const SAY = /^([^:«]{1,16}):\s*«(.*)»$/;

  /* ---------- ajustes ---------- */
  document.body.classList.toggle("reduce", S.reduce);
  const mt = document.getElementById("motion-toggle");
  mt.setAttribute("aria-pressed", String(S.reduce));
  mt.addEventListener("click", () => { S.reduce = !S.reduce; store.set("dm2-reduce", S.reduce); document.body.classList.toggle("reduce", S.reduce); mt.setAttribute("aria-pressed", String(S.reduce)); });
  const SND = [["Sonido: no", 0], ["Sonido: bajo", 0.04], ["Sonido: medio", 0.09]];
  const sb = document.getElementById("sound-toggle");
  const paintSnd = () => { sb.querySelector("span").textContent = SND[S.snd][0]; sb.setAttribute("aria-pressed", String(S.snd > 0)); };
  let actx = null;
  function tone(freqs, type) {
    const vol = SND[S.snd][1];
    if (!vol || !(window.AudioContext || window.webkitAudioContext)) return;
    try {
      actx = actx || new (window.AudioContext || window.webkitAudioContext)();
      freqs.forEach((f, i) => {
        const o = actx.createOscillator(), g = actx.createGain(), t = actx.currentTime + i * 0.12;
        o.type = type || "sine"; o.frequency.value = f;
        g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vol, t + 0.03); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.45);
        o.connect(g).connect(actx.destination); o.start(t); o.stop(t + 0.5);
      });
    } catch (e) { /* sin audio */ }
  }
  const sndGood = () => tone([523.25, 659.25, 783.99]);
  const sndBad = () => tone([196, 146.83], "triangle");
  sb.addEventListener("click", () => { S.snd = (S.snd + 1) % 3; store.set("dm2-snd", S.snd); paintSnd(); sndGood(); });
  paintSnd();

  function toast(msg) {
    while ($toasts.children.length > 2) $toasts.firstChild.remove();
    const el = document.createElement("div"); el.className = "toast"; el.textContent = msg; $toasts.appendChild(el);
    setTimeout(() => el.remove(), 2300);
  }

  /* ---------- retratos con expresiones ---------- */
  function portrait(spec, mood, cls) {
    const p = spec || PRESETS[0];
    const st = p.style || "short";
    const back = {
      long: '<path class="hair out" d="M40 104 C30 36 170 36 160 104 L170 196 C140 184 60 184 30 196Z"/>',
      curly: '<g class="hair out"><circle cx="50" cy="76" r="23"/><circle cx="68" cy="48" r="24"/><circle cx="100" cy="38" r="25"/><circle cx="132" cy="48" r="24"/><circle cx="150" cy="76" r="23"/></g>',
      bun: '<circle class="hair out" cx="100" cy="26" r="20"/>',
    }[st] || "";
    const front = {
      short: '<path class="hair out" d="M47 96 C40 38 160 36 153 96 C142 68 120 58 100 60 C80 58 58 68 47 96Z"/>',
      bun: '<path class="hair out" d="M47 96 C40 38 160 36 153 96 C142 68 120 58 100 60 C80 58 58 68 47 96Z"/>',
      long: '<path class="hair out" d="M48 92 C46 44 154 44 152 92 C138 72 112 64 100 64 C86 64 62 74 48 92Z"/>',
      curly: '<path class="hair out" d="M56 84 C70 58 130 58 144 84 C128 72 72 72 56 84Z"/>',
      cap: '<path class="shirt out" d="M46 86 C44 34 156 34 154 86Z"/><path class="shirt out" d="M46 86 H176 C176 98 162 98 150 94 H52Z"/>',
    }[st];
    const eyesBy = {
      calm: '<ellipse class="ink" cx="76" cy="102" rx="6" ry="8"/><ellipse class="ink" cx="124" cy="102" rx="6" ry="8"/>',
      happy: '<path class="thin" d="M66 104 Q76 92 86 104 M114 104 Q124 92 134 104"/>',
      proud: '<path class="thin" d="M66 104 Q76 94 86 104 M114 104 Q124 94 134 104"/>',
      relaxed: '<ellipse class="ink" cx="76" cy="105" rx="6" ry="4"/><ellipse class="ink" cx="124" cy="105" rx="6" ry="4"/><path class="thin" d="M64 100 H88 M112 100 H136"/>',
      tired: '<ellipse class="ink" cx="76" cy="105" rx="6" ry="3.5"/><ellipse class="ink" cx="124" cy="105" rx="6" ry="3.5"/><path class="thin" d="M64 100 H88 M112 100 H136"/><path class="thin" style="opacity:.35" d="M66 114 Q76 119 86 114 M114 114 Q124 119 134 114"/>',
      tipsy: '<ellipse class="ink" cx="79" cy="104" rx="6" ry="5"/><ellipse class="ink" cx="127" cy="104" rx="6" ry="5"/><path class="thin" d="M64 98 H88 M112 94 H136"/>',
      sleepy: '<path class="thin" d="M66 102 Q76 112 86 102 M114 102 Q124 112 134 102"/>',
      out: '<path class="thin" d="M66 104 Q76 112 86 104 M114 104 Q124 112 134 104"/>',
      scared: '<circle class="white ln" style="stroke-width:3" cx="76" cy="100" r="11"/><circle class="white ln" style="stroke-width:3" cx="124" cy="100" r="11"/><circle class="ink" cx="76" cy="101" r="3.5"/><circle class="ink" cx="124" cy="101" r="3.5"/>',
      worried: '<ellipse class="ink" cx="76" cy="103" rx="6" ry="7"/><ellipse class="ink" cx="124" cy="103" rx="6" ry="7"/>',
      angry: '<ellipse class="ink" cx="76" cy="104" rx="6" ry="6"/><ellipse class="ink" cx="124" cy="104" rx="6" ry="6"/>',
      hurt: '<path class="thin" d="M66 100 L86 108 M86 100 L66 108"/><ellipse class="ink" cx="124" cy="104" rx="6" ry="5"/>',
    };
    const brows = {
      worried: '<path class="thin" d="M64 86 L88 76 M136 86 L112 76"/>',
      scared: '<path class="thin" d="M64 80 Q76 70 88 78 M136 80 Q124 70 112 78"/>',
      angry: '<path class="thin" d="M62 78 L90 90 M138 78 L110 90"/>',
      tipsy: '<path class="thin" d="M64 88 H88 M112 82 Q124 74 136 82"/>',
      hurt: '<path class="thin" d="M64 88 L88 82 M136 88 L112 82"/>',
      tired: '<path class="thin" d="M64 90 Q76 86 88 90 M112 90 Q124 86 136 90"/>',
    };
    const mouths = {
      calm: '<path class="thin" d="M86 138 Q100 146 114 138"/>',
      happy: '<path class="ink" d="M80 132 Q100 156 120 132 Q100 140 80 132Z"/>',
      proud: '<path class="thin" d="M84 136 Q100 148 116 134"/>',
      relaxed: '<path class="thin" d="M84 138 Q100 146 116 138"/>',
      tipsy: '<path class="thin" d="M82 140 Q92 132 100 140 T118 138"/>',
      tired: '<path class="thin" d="M88 142 H112"/>',
      sleepy: '<path class="thin" d="M90 142 Q100 146 110 142"/>',
      out: '<path class="thin" style="stroke:#6f86b8" d="M88 144 H112"/>',
      worried: '<path class="thin" d="M86 146 Q100 136 114 146"/>',
      scared: '<ellipse class="ink" cx="100" cy="144" rx="9" ry="11"/>',
      angry: '<path class="thin" d="M84 146 Q100 136 116 146"/>',
      hurt: '<path class="thin" d="M86 146 Q100 138 114 146"/>',
    };
    const glasses = p.glasses ? '<circle class="glass" cx="76" cy="102" r="17"/><circle class="glass" cx="124" cy="102" r="17"/><path class="thin" d="M93 100 H107"/>' : "";
    const sweat = (mood === "worried" || mood === "scared") ? '<path class="drop" d="M158 66 q9 13 0 20 q-9 -7 0 -20z"/>' : "";
    const patch = mood === "hurt" ? '<rect class="patch" x="108" y="62" width="26" height="14" rx="4" transform="rotate(-12 121 69)"/>' : "";
    const pale = mood === "out" ? '<ellipse cx="100" cy="102" rx="52" ry="58" fill="#dfeaf0" opacity=".38"/>' : "";
    const cheekOp = mood === "tipsy" ? .85 : mood === "scared" || mood === "out" ? 0 : .45;
    const label = MOODS[mood] || "";
    return `<svg class="port m-${mood} ${cls || ""}" viewBox="0 0 200 244" role="img" aria-label="Personaje. ${label}" style="--skin:${p.skin};--hairc:${p.hair};--shirt:${p.body}">
      ${back}<circle class="skin out" cx="46" cy="108" r="10"/><circle class="skin out" cx="154" cy="108" r="10"/>
      <path class="skin out" d="M84 140 H116 V182 H84Z"/>
      <path class="shirt out" d="M16 244 C16 196 52 176 100 176 C148 176 184 196 184 244Z"/>
      <path class="ln" d="M80 178 L100 202 L120 178"/>
      <ellipse class="skin out" cx="100" cy="102" rx="52" ry="58"/>${pale}
      <circle class="cheek" style="opacity:${cheekOp}" cx="62" cy="122" r="9"/><circle class="cheek" style="opacity:${cheekOp}" cx="138" cy="122" r="9"/>
      ${eyesBy[mood] || eyesBy.calm}${brows[mood] || ""}${mouths[mood] || mouths.calm}${patch}${front}${glasses}${sweat}</svg>`;
  }
  const userSpec = () => PRESETS[S.av] || PRESETS[0];
  const avatar = (spec, mood) => `<span class="cast-av" aria-hidden="true">${portrait(spec, mood || "calm")}</span>`;
  function userMood(stats, keys, owner) {
    const vals = keys.map((k) => stats[k]); const avg = vals.reduce((a, b) => a + b, 0) / vals.length, min = Math.min(...vals);
    if (owner === "npc") return min <= 1 ? "scared" : min <= 2 ? "worried" : "calm";
    if (min <= 0 || avg < 1.5) return "scared";
    if (avg < 2.6) return "worried";
    if (avg < 3.6) return "tired";
    return "calm";
  }
  const userLabel = (m) => ({ calm: "Todo bien por ahora", tired: "Algo cambió en ti", worried: "Te sientes mal", scared: "Necesitas ayuda" }[m] || MOODS[m]);

  /* ---------- fondo: figuras variadas con la identidad del juego ---------- */
  const DOODLE = ["ph-heartbeat", "ph-brain", "ph-lightning", "ph-pill", "ph-wine", "ph-cloud", "ph-moon", "ph-key", "ph-phone", "ph-scales", "ph-wind", "ph-eye", "ph-smiley", "ph-book-open-text", "ph-drop", "ph-coffee", "ph-notebook", "ph-car-profile", "ph-lifebuoy", "ph-flask", "ph-alarm", "ph-hand-heart", "ph-first-aid-kit", "ph-chats-circle", "ph-taxi", "ph-backpack"];
  function paintDoodle() {
    const el = document.getElementById("doodle"); if (!el) return;
    let seed = 7; const rnd = () => { seed |= 0; seed = (seed + 0x6D2B79F5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
    const cell = 96, rows = Math.ceil(innerHeight / cell) + 1, cols = Math.ceil(innerWidth / cell) + 1; let html = "", idx = 0;
    for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
      if (rnd() < 0.22) continue;                                   // huecos: se ve irregular, no una cuadrícula
      const ic = DOODLE[(idx++ * 7 + Math.floor(rnd() * 5)) % DOODLE.length];
      const x = c * cell + (r % 2 ? cell / 2 : 0) + (rnd() - .5) * 26, y = r * cell + (rnd() - .5) * 26;
      html += `<i class="ph ${ic}" style="left:${x.toFixed(0)}px;top:${y.toFixed(0)}px;font-size:${(24 + rnd() * 16).toFixed(0)}px;transform:rotate(${((rnd() - .5) * 56).toFixed(0)}deg)"></i>`;
    }
    el.innerHTML = html;
  }
  paintDoodle(); let rz; window.addEventListener("resize", () => { clearTimeout(rz); rz = setTimeout(paintDoodle, 200); });

  /* ---------- hoja de contexto y efecto ---------- */
  let $peek = null;
  function closePeek() { if ($peek) { $peek.remove(); $peek = null; } }
  function peek(icon, title, ctx, fx, foot) {
    closePeek();
    $peek = document.createElement("div"); $peek.className = "peek"; $peek.setAttribute("role", "dialog"); $peek.setAttribute("aria-label", title);
    $peek.innerHTML = `<div class="peek-h"><i class="ph-bold ${icon} ic" aria-hidden="true"></i><span>${esc(title)}</span><button class="x" type="button" aria-label="Cerrar"><i class="ph-bold ph-x"></i></button></div>
      ${ctx ? `<div class="frow"><span class="lb"><i class="ph-bold ph-info"></i>Contexto</span><p>${esc(ctx)}</p></div>` : ""}
      ${fx ? `<div class="frow fx"><span class="lb"><i class="ph-bold ph-lightning"></i>Efecto</span><p>${esc(fx)}</p></div>` : ""}
      ${foot ? `<div class="foot">${esc(foot)}</div>` : ""}`;
    document.body.appendChild($peek);
    $peek.querySelector(".x").addEventListener("click", closePeek);
    $peek.querySelector(".x").focus({ preventScroll: true });
  }
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closePeek(); });
  document.addEventListener("click", (e) => { if ($peek && !e.target.closest(".peek") && !e.target.closest("[data-peek]")) closePeek(); });

  /* ---------- vistas generales ---------- */
  function home() {
    return `<section class="home">
      <div>
        <span class="kicker"><i class="ph-bold ph-game-controller"></i>Juego de decisiones reales</span>
        <h1>Dentro<br>de <em>Mí</em></h1>
        <p class="lead">Una noche. Una decisión. Tu cuerpo responde. Sin sermones: aquí se cuenta lo que de verdad pasa.</p>
        <form class="start-form" id="start">
          <div class="field"><label for="nm">¿Cómo te llamas?</label><input id="nm" name="nm" maxlength="14" autocomplete="off" placeholder="Tu nombre o apodo" value="${esc(S.name)}"></div>
          <div class="field"><span class="lbl" id="avl">Elige tu personaje</span>
            <div class="avs" role="radiogroup" aria-labelledby="avl">${PRESETS.map((p, i) => `<button type="button" class="av" role="radio" aria-checked="${i === S.av}" aria-label="Personaje ${i + 1}" data-av="${i}">${portrait(p, "happy")}</button>`).join("")}</div></div>
          <div><button class="btn btn-go" type="submit">Jugar<i class="ph-bold ph-arrow-right"></i></button></div>
        </form>
      </div>
      <div class="home-art" aria-hidden="true">
        <div id="hero-port">${portrait(userSpec(), "happy")}</div>
        <span class="float f1"><i class="ph-bold ph-lightning"></i>Reflejos</span>
        <span class="float f2"><i class="ph-bold ph-heartbeat"></i>Corazón</span>
        <span class="float f3"><i class="ph-bold ph-book-open-text"></i>Memoria</span>
      </div>
    </section>
    <section class="steps">
      <div class="card step"><i class="ph-bold ph-signpost"></i><h3>Elige qué haces</h3><p>Cada caso es una historia corta. Tus decisiones cambian cómo termina.</p></div>
      <div class="card step"><i class="ph-bold ph-hand-pointing"></i><h3>Toca todo</h3><p>Objetos, barras del cuerpo y fuentes: cada uno te da su contexto y su efecto.</p></div>
      <div class="card step"><i class="ph-bold ph-flask"></i><h3>Entérate de lo real</h3><p>Datos directos, con fuente, sin rodeos ni miedo barato.</p></div>
    </section>`;
  }
  function wireHome() {
    document.querySelectorAll("[data-av]").forEach((b) => b.addEventListener("click", () => {
      S.av = Number(b.dataset.av);
      document.querySelectorAll("[data-av]").forEach((x) => x.setAttribute("aria-checked", String(x === b)));
      document.getElementById("hero-port").innerHTML = portrait(userSpec(), "happy");
    }));
    document.getElementById("start").addEventListener("submit", (e) => { e.preventDefault(); S.name = document.getElementById("nm").value.trim(); save(); location.hash = "#/casos"; });
  }

  function endsDots(c) {
    const found = (S.prog[c.id] || {}).ends || {};
    return Object.keys(c.nodes).filter((k) => c.nodes[k].end).map((k) => `<span class="dot ${found[k] ? "on " + found[k] : ""}"></span>`).join("");
  }
  function casesView(filter) {
    const list = CASES.filter((c) => filter === "todos" || c.tag === filter);
    const chips = [["todos", "Todos"], ...Object.entries(TAGS)].map(([k, v]) => `<button class="chip" type="button" data-f="${k}" aria-pressed="${k === filter}">${v}</button>`).join("");
    return `<div class="page-head"><h1>${S.name ? esc(S.name) + ", elige" : "Elige"} un caso</h1><p>Cada uno es una historia distinta. Entra a donde quieras. Los puntos de abajo son los finales que ya viste.</p></div>
      <div class="chips" role="group" aria-label="Filtrar por tema">${chips}</div>
      <div class="grid">${list.map((c) => `<article class="case cc-${c.color}">
        <div class="case-top"><span class="big"><i class="ph-bold ${c.icon}"></i></span><span class="tagpill">${TAGS[c.tag]}</span></div>
        <div class="case-body"><h2>${esc(c.title)}</h2><p>${esc(c.hook)}</p>
          <div class="case-foot"><span class="ends" title="Finales descubiertos">${endsDots(c)}</span>
            <span class="case-btns"><a class="btn btn-ghost btn-sm" href="#/caso/${c.id}">Detalles</a><a class="btn btn-go btn-sm" href="#/jugar/${c.id}">Jugar<i class="ph-bold ph-play"></i></a></span></div></div></article>`).join("")}</div>`;
  }
  function wireCases() { document.querySelectorAll("[data-f]").forEach((b) => b.addEventListener("click", () => { $app.innerHTML = casesView(b.dataset.f); wireCases(); })); }

  function introView(c) {
    return `<nav class="crumbs"><a href="#/casos"><i class="ph-bold ph-arrow-left"></i>Casos</a><span aria-hidden="true">/</span><span>${esc(c.title)}</span></nav>
      <div class="intro">
        <article class="card intro-main cc-${c.color}">
          <div class="case-top"><span class="big"><i class="ph-bold ${c.icon}"></i></span><span class="tagpill">${TAGS[c.tag]}</span></div>
          <div class="body" style="background:var(--card)">
            <h1>${esc(c.title)}</h1>
            <p class="story">${esc(fill(c.story))}</p>
            <div class="cast" aria-label="Personajes">${c.cast.map((p) => `<div class="cast-row">${avatar(NPCS[p[0]], "happy")}<div><strong>${esc(p[0])}</strong> <span>${esc(p[1])}</span></div></div>`).join("")}</div>
            <div class="end-actions"><a class="btn btn-go" href="#/jugar/${c.id}">Jugar desde el principio<i class="ph-bold ph-play"></i></a><a class="btn btn-ghost" href="#/guia/${c.guide}"><i class="ph-bold ph-book-open-text"></i>Qué pasa de verdad</a></div>
          </div>
        </article>
        <aside class="card side"><h2>Entrar a una escena</h2><p style="color:var(--ink-2);font-size:.95rem">Salta directo a un momento clave del caso.</p>
          ${c.scenes.map((s, i) => `<a class="scene-btn" href="#/jugar/${c.id}/${s[1]}"><span><span class="n">${i + 1}</span>${esc(s[0])}</span><i class="ph-bold ph-arrow-right"></i></a>`).join("")}
          <p class="ends" style="margin-top:6px">Finales: ${endsDots(c)}</p></aside>
      </div>`;
  }

  function guideList() {
    return `<div class="page-head"><h1>Lo que de verdad pasa</h1><p>Sin rodeos: qué sientes, qué le pasa a tu cuerpo, qué es mito, cuándo es urgente y qué ayuda.</p></div>
      <div class="sheets">${GUIDES.map((g) => `<a class="card sheet-card" href="#/guia/${g.id}"><span class="big"><i class="ph-bold ${g.icon}"></i></span><div><h2>${esc(g.title)}</h2><p>${esc(g.src)}</p></div></a>`).join("")}</div>`;
  }
  function guideSheet(g) {
    const rel = CASES.filter((c) => c.guide === g.id);
    return `<nav class="crumbs"><a href="#/guia"><i class="ph-bold ph-arrow-left"></i>Guía</a><span aria-hidden="true">/</span><span>${esc(g.title)}</span></nav>
      <article class="card sheet">
        <div class="sheet-head"><span class="big"><i class="ph-bold ${g.icon}"></i></span><div><h1>${esc(g.title)}</h1><p>Fuentes: ${esc(g.src)}</p></div></div>
        ${g.sections.map((s) => `<details class="sec ${s.h === "Es urgente si" ? "urgent" : ""}" open><summary>${esc(s.h)}<i class="ph-bold ph-caret-down"></i></summary><div class="in">${
          s.items ? s.items.map((m) => `<div class="myth"><div class="m"><i class="ph-bold ph-x-circle"></i>${esc(m[0])}</div><div class="r"><i class="ph-bold ph-check-circle"></i>${esc(m[1])}</div></div>`).join("") : `<p>${esc(s.t)}</p>`}</div></details>`).join("")}
      </article>
      ${rel.length ? `<div class="end-actions" style="margin-top:20px">${rel.map((c) => `<a class="btn btn-go" href="#/jugar/${c.id}"><i class="ph-bold ph-play"></i>Jugar: ${esc(c.title)}</a>`).join("")}</div>` : ""}`;
  }

  /* ---------- motor de juego ---------- */
  let G = null;
  const clamp = (v) => Math.max(0, Math.min(4, v));
  const bucket = (v) => (v <= 1 ? 0 : v <= 3 ? 1 : 2);
  function tileHTML(k, v) {
    const st = STAT[k];
    return `<button class="tile v${v}" type="button" data-k="${k}" data-peek="1" aria-label="${st.n}: ${st.l[v]}. Toca para saber qué significa."><i class="ph-bold ${st.i} ic" aria-hidden="true"></i><span class="nm">${st.n}</span>
      <span class="cells" aria-hidden="true">${[1, 2, 3, 4].map((n) => `<span class="${n <= v ? "on" : ""}"></span>`).join("")}</span><span class="lab">${st.l[v]}</span></button>`;
  }
  const speakerOf = (n) => { for (let i = n.t.length - 1; i >= 0; i--) { const m = n.t[i].match(SAY); if (m && NPCS[m[1]]) return m[1]; } return null; };

  function startPlay(c, nodeId) {
    document.body.dataset.wash = c.color;
    closePeek();
    const npcOwner = c.owner === "npc";
    G = { c, stats: Object.fromEntries(Object.keys(STAT).map((k) => [k, 4])), care: 0, hist: [], node: null, token: 0, echo: "", npc: null, mood: null, seen: {}, inv: [] };
    const npcName = c.fixedNpc || c.npc0;
    $app.innerHTML = `<div class="play">
      <div class="play-bar"><a class="back" href="#/caso/${c.id}"><i class="ph-bold ph-arrow-left"></i>${esc(c.title)}</a>
        <span class="score" id="score" title="Puntos por decidir con cuidado y mirar a tu alrededor"><i class="ph-fill ph-heart"></i><span id="care">0</span> cuidado</span></div>
      <aside class="card you" aria-label="Tú"><div class="you-head"><div id="yface"></div><div><span class="role">TÚ</span><div class="who">${esc(me())}</div><div class="mood" id="ymood"></div></div></div>
        ${npcOwner ? `<p class="note-you">Tu turno: lo que hagas cambia cómo está ${esc(npcName)}.</p>` : `<div class="tiles" id="tiles">${c.stats.map((k) => tileHTML(k, 4)).join("")}</div><p class="tiles-hint">Toca una barra para saber qué significa.</p>`}
        <div class="inv" id="inv" aria-label="Tus objetos"></div></aside>
      <section class="card scene" id="scene" aria-label="La historia">
        <div class="scene-bg" data-scene="${c.id}"><div class="npc-tag" id="tag"></div><div class="npc" id="npc"></div><span class="npc-mood" id="nmood"></span></div>
        ${npcOwner ? `<div class="npc-stats"><div class="tiles" id="tiles">${c.stats.map((k) => tileHTML(k, 4)).join("")}</div><p class="tiles-hint">Toca una barra para saber qué significa.</p></div>` : ""}
        <div class="talk" id="talk" aria-live="polite"></div></section>
      <section class="under" id="under"></section></div>`;
    $app.querySelector(".play").addEventListener("click", tileClick);
    $app.querySelector(".play").addEventListener("click", invClick);
    paintInv();
    if (nodeId !== c.start && c.jump && c.jump[nodeId]) {   // entrar directo a una escena: el cuerpo ya llega cambiado
      Object.entries(c.jump[nodeId]).forEach(([k, dv]) => { if (c.stats.includes(k)) G.stats[k] = clamp(G.stats[k] + dv); });
      document.getElementById("tiles").innerHTML = c.stats.map((k) => tileHTML(k, G.stats[k])).join("");
    }
    paintYou();
    enter(nodeId);
  }
  function tileClick(e) {
    const t = e.target.closest(".tile"); if (!t || !G) return;
    const k = t.dataset.k, v = G.stats[k], info = STATINFO[k], st = STAT[k];
    peek(st.i, `${st.n}: ${st.l[v]}`, info.ctx, info.fx[bucket(v)]);
  }
  /* Mochila: los objetos se suman cuando aparecen en cada etapa. */
  function paintInv() {
    const box = document.getElementById("inv"); if (!box) return;
    box.innerHTML = `<div class="inv-h"><i class="ph-bold ph-backpack" aria-hidden="true"></i>Tus objetos<span class="inv-n">${G.inv.length}</span></div>` +
      (G.inv.length ? `<div class="inv-grid">${G.inv.map((o) => `<button class="obj ${o.seen ? "seen" : ""} ${o.isNew ? "new" : ""}" type="button" data-peek="1" data-o="${esc(o.uid)}" aria-label="${esc(o.l)}. Toca para ver contexto y efecto."><i class="ph-bold ${o.ic}" aria-hidden="true"></i><span>${esc(o.l)}</span></button>`).join("")}</div>`
        : `<p class="inv-empty">Aún no ves nada. Los objetos aparecen a medida que avanza la historia.</p>`);
  }
  function addObjects(n, id) {
    (n.o || []).forEach((o) => { const uid = `${G.c.id}:${id}:${o.k}`; if (!G.inv.some((x) => x.uid === uid)) G.inv.push({ ...o, uid, isNew: true, seen: false }); });
    paintInv(); G.inv.forEach((o) => { o.isNew = false; });
  }
  function invClick(e) {
    const b = e.target.closest("[data-o]"); if (!b || !G) return;
    const o = G.inv.find((x) => x.uid === b.dataset.o); if (!o) return;
    if (!o.seen) { o.seen = true; b.classList.add("seen"); addCare(2, "Observaste"); }
    peek(o.ic, o.l, o.ctx, o.fx);
  }
  function paintYou() {
    const m = userMood(G.stats, G.c.stats, G.c.owner);
    document.getElementById("yface").innerHTML = portrait(userSpec(), m);
    document.getElementById("ymood").textContent = userLabel(m);
  }
  function applyDelta(d) {
    Object.entries(d || {}).forEach(([k, dv]) => {
      if (!G.c.stats.includes(k)) return;
      const old = G.stats[k], nv = clamp(old + dv);
      if (nv === old) return;
      G.stats[k] = nv;
      const tile = document.querySelector(`.tile[data-k="${k}"]`); if (!tile) return;
      tile.outerHTML = tileHTML(k, nv);
      const t2 = document.querySelector(`.tile[data-k="${k}"]`), dir = nv < old ? "dn" : "up";
      t2.classList.add(dir);
      const pop = document.createElement("span"); pop.className = "pop " + dir; pop.textContent = (nv > old ? "+" : "") + (nv - old); t2.appendChild(pop);
      setTimeout(() => pop.remove(), 1500);
    });
    paintYou();
  }
  function paintNpc(n) {
    const c = G.c, name = c.fixedNpc || n.npc || speakerOf(n) || c.npc0, mood = n.m || "calm";
    const same = G.npc === name && G.mood === mood;
    G.npc = name; G.mood = mood;
    const role = (c.cast.find((p) => p[0] === name) || [])[1] || "";
    document.getElementById("tag").innerHTML = `<b>${esc(name)}</b><small>${esc(role)}</small>`;
    const box = document.getElementById("npc");
    box.className = "npc" + (same || S.reduce ? "" : " swap");
    box.innerHTML = portrait(NPCS[name], mood);
    document.getElementById("nmood").textContent = MOODS[mood];
  }

  function enter(id, restore) {
    closePeek();
    G.node = id; const n = G.c.nodes[id]; const my = ++G.token;
    paintNpc(n);
    if (!restore) addObjects(n, id);
    const talk = document.getElementById("talk"), under = document.getElementById("under");
    talk.innerHTML = `${G.echo ? `<div class="you-echo">${avatar(userSpec(), "calm")}<span>${esc(G.echo)}</span></div>` : ""}<div class="bubbles" id="bub" style="display:grid;gap:12px"></div>`;
    under.innerHTML = "";
    document.getElementById("scene").scrollIntoView?.({ behavior: S.reduce ? "auto" : "smooth", block: "start" });
    if (!restore && n.d) setTimeout(() => { if (G.token !== my) return; applyDelta(n.d); if (Object.values(n.d).some((v) => v < 0)) sndBad(); }, S.reduce ? 0 : 450);
    const lines = n.t.map(fill), bub = document.getElementById("bub");
    let i = 0, timer = null, hint = null;
    const addLine = () => {
      const m = lines[i].match(SAY), el = document.createElement("div");
      if (m) { el.className = "say"; el.innerHTML = `${avatar(NPCS[m[1]], "happy")}<div class="bub"><b>${esc(m[1])}</b>${esc(m[2])}</div>`; }
      else { el.className = "nar"; el.textContent = lines[i]; }
      bub.appendChild(el); i++;
    };
    const finish = () => {
      if (G.token !== my) return;
      clearTimeout(timer); while (i < lines.length) addLine();
      talk.removeEventListener("click", skip); if (hint) hint.remove();
      renderUnder(n, id);
    };
    const skip = () => finish();
    const tick = () => { if (G.token !== my) return; addLine(); timer = setTimeout(i < lines.length ? tick : finish, i < lines.length ? 1300 : 450); };
    if (restore || S.reduce) { while (i < lines.length) addLine(); finish(); }
    else { talk.addEventListener("click", skip); tick(); if (lines.length > 1) { hint = document.createElement("p"); hint.className = "skip-hint"; hint.textContent = "Toca para ir más rápido."; talk.appendChild(hint); } }
  }

  function factHTML(f) {
    const srcs = f.s.split(",").map((x) => x.trim());
    const refs = srcs.map((s) => { const r = SOURCES[s] || { n: s, full: s, type: "" }; return `<button class="refbtn" type="button" data-peek="1" data-src="${esc(s)}" aria-label="Referencia: ${esc(r.n)}. Toca para ver quién es."><i class="ph-bold ph-file-text" aria-hidden="true"></i><span><b>${esc(r.n)}</b><small>${esc(r.full)}</small></span></button>`; }).join("");
    return `<div class="fact"><div class="fact-h"><i class="ph-bold ph-flask" aria-hidden="true"></i>${esc(f.h)}</div>
      <div class="frow"><span class="lb"><i class="ph-bold ph-info" aria-hidden="true"></i>Contexto</span><div class="ctxcol">${refs}<p class="sum"><b>Resumen</b>${esc(f.ctx)}</p></div></div>
      <div class="frow fx"><span class="lb"><i class="ph-bold ph-lightning" aria-hidden="true"></i>Efecto</span><p>${esc(f.fx)}</p></div>
      ${f.more ? `<div class="fact-f"><button class="chipbtn" type="button" data-peek="1" data-more="1"><i class="ph-bold ph-plus"></i>Saber más</button></div><div class="more" hidden>${esc(f.more)}</div>` : ""}</div>`;
  }
  function renderUnder(n, id) {
    const under = document.getElementById("under");
    let html = "";
    if (n.fact) html += factHTML(n.fact);
    if (n.end) html += endHTML(id, n);
    else if (n.c) html += `<div class="turn">${avatar(userSpec(), "calm")}<span>Tu turno: ¿qué haces?</span></div><div class="choices" role="group" aria-label="¿Qué haces?">${n.c.map((c, k) => `<button class="choice" type="button" style="--i:${k}" data-k="${k}"><span class="k">${k + 1}</span><span>${esc(fill(c.t))}</span></button>`).join("")}</div>`;
    else if (n.go) html += `<div class="nextbar"><button class="btn btn-go" id="go" type="button">Seguir<i class="ph-bold ph-arrow-right"></i></button></div>`;
    under.innerHTML = html;
    under.querySelectorAll(".choice").forEach((b) => b.addEventListener("click", () => choose(n, Number(b.dataset.k))));
    under.querySelectorAll("[data-src]").forEach((b) => b.addEventListener("click", () => {
      const s = SOURCES[b.dataset.src] || { n: b.dataset.src, full: b.dataset.src, what: "" };
      peek("ph-file-text", `${s.n}: ${s.full}`, `${s.type ? s.type + ". " : ""}${s.what}`, "Respalda el resumen de esta tarjeta.", "Atribuida por conocimiento previo. Pendiente de verificar en la fuente original.");
    }));
    under.querySelectorAll("[data-more]").forEach((b) => b.addEventListener("click", () => {
      const m = b.closest(".fact").querySelector(".more"); m.hidden = !m.hidden; b.innerHTML = m.hidden ? '<i class="ph-bold ph-plus"></i>Saber más' : '<i class="ph-bold ph-minus"></i>Menos';
    }));
    const go = document.getElementById("go"); if (go) { go.addEventListener("click", () => { G.echo = ""; enter(n.go); }); go.focus({ preventScroll: true }); }
    if (n.end) wireEnd(id);
    if (n.end) setTimeout(() => under.scrollIntoView({ behavior: S.reduce ? "auto" : "smooth", block: "start" }), 80);
  }

  function addCare(v, why) {
    G.care += v; document.getElementById("care").textContent = G.care;
    const sc = document.getElementById("score"); sc.classList.remove("bump"); void sc.offsetWidth; sc.classList.add("bump");
    toast(`+${v} cuidado${why ? ": " + why.toLowerCase() : ""}`);
  }
  function choose(n, k) {
    const c = n.c[k];
    G.hist.push({ node: G.node, stats: { ...G.stats }, care: G.care, echo: G.echo, seen: { ...G.seen }, inv: G.inv.map((o) => ({ ...o, isNew: false })) });
    G.echo = fill(c.t);
    if (c.care) { addCare(c.care); sndGood(); }
    enter(c.to);
  }

  /* ---------- final ---------- */
  function endHTML(id, n) {
    const c = G.c, e = n.end;
    const p = (S.prog[c.id] = S.prog[c.id] || { ends: {}, best: 0 });
    p.ends[id] = e.k; p.best = Math.max(p.best, G.care); save();
    const total = Object.values(c.nodes).filter((x) => x.end).length, found = Object.keys(p.ends).length;
    const label = { good: ["ph-seal-check", "Buen final"], ok: ["ph-circle-half", "Final a medias"], bad: ["ph-warning", "Final difícil"] }[e.k];
    if (e.k === "good") sndGood(); else if (e.k === "bad") sndBad();
    return `<article class="card end"><div class="end-head ${e.k}"><span class="end-badge"><i class="ph-bold ${label[0]}"></i>${label[1]}</span><h2>${esc(e.h)}</h2></div>
      <div class="end-body">
        <div><h3><i class="ph-bold ph-flask"></i>Lo que de verdad pasó</h3>${e.real.map((r) => `<p>${esc(r)}</p>`).join("")}</div>
        <div class="tip"><h3><i class="ph-bold ph-lightbulb"></i>La próxima vez</h3><p>${esc(e.tip)}</p></div>
        <div class="sumrow"><span class="sumpill"><i class="ph-fill ph-heart" style="color:var(--coral)"></i>${G.care} puntos de cuidado</span><span class="sumpill"><i class="ph-bold ph-flag-checkered"></i>${found} de ${total} finales</span></div>
        <div class="end-actions">
          ${G.hist.length ? `<button class="btn btn-pri" id="rew" type="button"><i class="ph-bold ph-arrow-counter-clockwise"></i>Cambiar mi última decisión</button>` : ""}
          <button class="btn btn-ghost" id="again" type="button"><i class="ph-bold ph-repeat"></i>Jugar de nuevo</button>
          <a class="btn btn-ghost" href="#/casos"><i class="ph-bold ph-squares-four"></i>Otros casos</a>
          <a class="btn btn-ghost" href="#/guia/${c.guide}"><i class="ph-bold ph-book-open-text"></i>Leer la guía</a>
        </div></div></article>`;
  }
  function wireEnd() {
    const c = G.c, rew = document.getElementById("rew");
    if (rew) rew.addEventListener("click", () => {
      const snap = G.hist.pop(); G.stats = snap.stats; G.care = snap.care; G.echo = snap.echo; G.seen = snap.seen || {}; G.inv = snap.inv || [];
      document.getElementById("tiles").innerHTML = c.stats.map((k) => tileHTML(k, G.stats[k])).join("");
      document.getElementById("care").textContent = G.care; paintYou(); paintInv(); enter(snap.node, true);
    });
    document.getElementById("again").addEventListener("click", () => startPlay(c, c.start));
  }

  document.addEventListener("keydown", (e) => {
    if (!G || !/^#\/jugar/.test(location.hash) || e.target.matches("input,textarea")) return;
    const n = Number(e.key);
    if (n >= 1 && n <= 9) { const b = document.querySelector(`.choice[data-k="${n - 1}"]`); if (b) b.click(); }
    else if (e.key === "Enter" || e.key === " ") { const g = document.getElementById("go"); if (g && document.activeElement !== g) { e.preventDefault(); g.click(); } else if (!document.getElementById("under").innerHTML) { const t = document.getElementById("talk"); t && t.click(); } }
  });

  /* ---------- router ---------- */
  function route() {
    const parts = (location.hash || "#/").replace(/^#\/?/, "").split("/").filter(Boolean);
    let html = "", after = null;
    closePeek(); $toasts.innerHTML = "";
    const cur = ["casos", "caso", "jugar"].includes(parts[0]) ? "casos" : parts[0] === "guia" ? "guia" : "";
    document.querySelectorAll("[data-nav]").forEach((a) => (a.dataset.nav === cur ? a.setAttribute("aria-current", "page") : a.removeAttribute("aria-current")));
    if (G && parts[0] !== "jugar") { G.token++; G = null; }
    if (parts[0] !== "jugar") { const w = parts[0] === "caso" && caseOf(parts[1]); w ? (document.body.dataset.wash = w.color) : delete document.body.dataset.wash; }
    if (parts[0] === "casos") { html = casesView("todos"); after = wireCases; }
    else if (parts[0] === "caso") { const c = caseOf(parts[1]); if (!c) return void (location.hash = "#/casos"); html = introView(c); }
    else if (parts[0] === "guia") { const g = GUIDES.find((x) => x.id === parts[1]); html = g ? guideSheet(g) : guideList(); }
    else if (parts[0] === "jugar") {
      const c = caseOf(parts[1]); if (!c) return void (location.hash = "#/casos");
      $app.focus({ preventScroll: true }); window.scrollTo(0, 0); startPlay(c, c.nodes[parts[2]] ? parts[2] : c.start); return;
    } else { html = home(); after = wireHome; }
    $app.innerHTML = html; window.scrollTo(0, 0); $app.focus({ preventScroll: true });
    if (after) after();
  }
  window.addEventListener("hashchange", route);
  route();
})();
