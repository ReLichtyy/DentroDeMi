    nodes: {
      n1: { npc: "Mateo", m: "happy", o: [{"k": "porro", "ic": "ph-flame", "l": "El porro", "ctx": "Fumado, el THC se siente en minutos.", "fx": "Dura horas: justo las que necesitas para estudiar."}, {"k": "cuaderno", "ic": "ph-notebook", "l": "Tus apuntes", "ctx": "Llevas la mitad del temario.", "fx": "Seis horas de sueño rinden más que dos de estudio nublado."}], t: ["11 pm. Examen final a las 8:00. Llevas la mitad del temario.", "Mateo entra con un porro: «Fúmate uno. Te relaja y estudias mejor.»", "Tienes ganas de decir que sí. Es normal."],
        c: [{ t: "Fumar con Mateo para relajarte", to: "n2smoke", care: 0 }, { t: "Decir que no, pero hacer 15 minutos de pausa con él", to: "n2break", care: 10 }, { t: "Escribirle a Vale para estudiar juntos por videollamada", to: "n2vale", care: 10 }] },
      n2smoke: { npc: "Mateo", m: "relaxed", t: ["A los pocos minutos llega la calma y el tiempo se estira.", "Lees la misma página tres veces. Se siente profundo, pero no se queda.", "Tu mente está tranquila. Tu memoria, en pausa."], d: { foco: -2, memoria: -2, corazon: -1 },
        fact: { h: "Lo que hace el THC mientras dura", ctx: "El THC actúa donde se forman los recuerdos y se sostiene la atención.", fx: "Cuesta concentrarse y guardar lo nuevo mientras dura.", more: "El THC actúa justo donde se forman los recuerdos nuevos y se sostiene la atención. Mientras dura, cuesta concentrarse y guardar información nueva. Fumado se nota en minutos y dura horas.", s: "NIDA" },
        c: [{ t: "Intentar estudiar así", to: "n3study", care: 0 }, { t: "Dejar los libros y dormir", to: "n3sleep", care: 5 }, { t: "Fumar otro para calmar los nervios", to: "n3panic", care: 0 }] },
      n3study: { npc: "Mateo", m: "tired", t: ["Dos horas de apuntes que no recuerdas haber hecho.", "A las 3 am abres el cuaderno y la mitad parece escrita por otra persona.", "En el examen, las respuestas están casi ahí. Casi."], d: { memoria: -1, sueno: -2, animo: -1 },
        end: { k: "bad", h: "Casi me acuerdo", real: ["Lo que estudias con el cerebro en pausa se guarda peor.", "No estudiaste menos tiempo: estudiaste peor."], tip: "Si necesitas bajar la ansiedad antes de un examen, una pausa corta y dormir rinden más." } },
      n3sleep: { npc: "Mateo", m: "calm", t: ["Cierras los libros. Duermes seis horas con un poco de culpa.", "A las 7 la cabeza está medio clara. Está."], d: { sueno: -1 },
        end: { k: "ok", h: "Menos preparado, pero entero", real: ["Dormir salvó lo que ya habías estudiado.", "El examen sale más o menos. No fue la noche perfecta, pero no empeoró."], tip: "Con sueño, el examen se rinde con lo que ya tienes. Sin sueño, se rinde con menos." } },
      n3panic: { npc: "Mateo", m: "worried", o: [{"k": "pulso", "ic": "ph-heartbeat", "l": "Tu pulso", "ctx": "El THC acelera el corazón.", "fx": "Parece peligro, pero en general baja en horas. Acompañado baja más rápido."}], t: ["Segundo porro. El corazón se acelera y se te cierra la garganta.", "Piensas que algo está mal. Es un ataque de pánico por THC: se siente horrible, pero pasa."], d: { animo: -3, corazon: -2 },
        fact: { h: "El THC también puede dar pánico", ctx: "Más THC puede subir la ansiedad y el pulso.", fx: "Asusta mucho. No se sabe de antemano quién reacciona así.", more: "Más THC puede subir la ansiedad, la paranoia y el pulso. Asusta mucho. No hay forma de saber de antemano quién reacciona así.", s: "NIDA" },
        c: [{ t: "Respirar lento y pedirle a Mateo que no te deje solo", to: "n4breathe", care: 10 }, { t: "Salir a la calle solo hasta que se pase", to: "n4alone", care: 0 }] },
      n4breathe: { npc: "Mateo", m: "calm", t: ["Mateo se sienta contigo y habla bajito: «Estás bien, ya va a pasar.»", "En una hora el pulso baja. Nadie durmió bien."], d: { animo: 2, corazon: 1 },
        end: { k: "ok", h: "Pasó. Con compañía pasó más fácil", real: ["Acompañar y bajar el ritmo funciona mejor que pelear con el pánico.", "Aun así, perdiste la noche de estudio."], tip: "Si el dolor de pecho o la confusión no ceden, llama al 911." } },
      n4alone: { npc: "Mateo", m: "worried", t: ["Caminas sin rumbo, confundido y con miedo. Te sientas 40 minutos en una banca.", "Vuelves con frío y sin haber dormido. El examen es en cinco horas."], d: { sueno: -2, animo: -1 },
        end: { k: "bad", h: "La peor versión de la noche", real: ["Pasar un pánico solo lo hace más largo.", "Una persona al lado ayuda más que cualquier truco."], tip: "Avisa a alguien. No tiene que ser perfecto: tiene que estar contigo." } },
      n2break: { npc: "Mateo", m: "relaxed", t: ["Mateo fuma en el balcón. Tú tomas aire, agua y quince minutos.", "Vuelves al escritorio con ganas de terminar. Y terminas."], go: "n3good" },
      n2vale: { npc: "Vale", m: "happy", t: ["Vale contesta enseguida: «Ya mismo abro el link.»", "Se dividen temas y se los explican. Va más rápido que solo."], go: "n3good" },
      n3good: { npc: "Vale", m: "proud", t: ["A la 1 am cierras. Duermes casi seis horas.", "El cerebro consolida lo estudiado mientras duermes, y eso se nota a las 8."],
        fact: { h: "Dormir es parte de estudiar", ctx: "El sueño consolida la memoria.", fx: "Dormir poco después de estudiar borra parte de lo aprendido.", more: "El sueño ayuda a consolidar la memoria. Dormir poco después de estudiar borra parte de lo aprendido.", s: "CDC" },
        end: { k: "good", h: "Llegaste con la cabeza completa", real: ["Estudiar con la cabeza clara rinde más que relajarse con THC.", "Bajar nervios sin sustancias es posible: pausa, agua, compañía."], tip: "La mejor ayuda esta noche fue una persona y seis horas de sueño." } },
    },
  },

  /* ---------------------------------------------------------------- 3 */
  {
    id: "vapeo", jump: { n3: { corazon: -1 } }, npc0: "Valeria",  title: "Solo uno más", tag: "vapeo", icon: "ph-cloud", color: "yellow",
    hook: "Empezó con un vape de mango entre dos clases.",
    story: "Valeria te ofrece uno en el patio. Dice que no raspa, que ni se siente. Eso es justo lo que lo vuelve fácil de repetir.",
    cast: [["Valeria", "tu amiga"], ["Camilo", "tu hermano mayor"]],
    stats: ["foco", "animo", "corazon", "sueno", "aire"],
    start: "n1", guide: "vapeo",
    scenes: [["El primer vape", "n1"], ["Una semana después", "n3"], ["Un mes después", "n4hook"]],
    nodes: {
      n1: { npc: "Valeria", m: "happy", o: [{"k": "vape", "ic": "ph-cloud", "l": "El vape", "ctx": "Sabor a mango y casi sin raspar.", "fx": "Eso lo vuelve fácil de repetir, no menos adictivo."}], t: ["Entre clases, en el patio. Valeria saca un vape de mango.", "Valeria: «Pruébalo, {yo}. Ni raspa. Ni se siente.»", "Justo eso lo vuelve fácil de repetir."],
        c: [{ t: "Probar una vez", to: "n2try", care: 0 }, { t: "No, gracias", to: "n2no", care: 10 }] },
      n2no: { npc: "Valeria", m: "calm", t: ["Valeria se encoge de hombros: «Va.» Y ya.", "Nadie te saca del grupo. Esa parte casi nunca pasa."],
        end: { k: "good", h: "Una pausa menos", real: ["Decir que no casi siempre cuesta menos de lo que imaginas.", "La nicotina engancha rápido, y mientras antes se empieza, más cuesta salir."], tip: "Si te vuelven a ofrecer, ya sabes que dos palabras bastan." } },
      n2try: { npc: "Valeria", m: "happy", t: ["Un mareo suave, el corazón un poco más rápido, una ola corta de calma.", "Dura poco. Y por eso te pide otro.", "Eso no es calma real: es tu cerebro aprendiendo a pedir más."], d: { corazon: -1 },
        fact: { h: "Por qué engancha tan rápido", ctx: "La nicotina activa el sistema de recompensa en segundos.", fx: "El efecto dura poco, así que tu cerebro pide otro.", more: "La nicotina llega al cerebro en segundos y activa el sistema de recompensa (dopamina). El efecto dura poco, así que el cerebro aprende a pedir más. Algunos vapes entregan nicotina en formas que no raspan la garganta, por eso se usan más seguido.", s: "NIDA, CDC" }, go: "n3" },
      n3: { npc: "Valeria", m: "calm", o: [{"k": "reloj", "ic": "ph-timer", "l": "El reloj", "ctx": "Un antojo dura pocos minutos.", "fx": "Cinco minutos de espera lo desarman."}], t: ["Una semana después. Entre clases lo piensas sin querer.", "«Solo uno.» Ya no es curiosidad: es un hábito en construcción."],
        c: [{ t: "Comprar uno propio por si acaso", to: "n4hook", care: 0 }, { t: "Esperar cinco minutos y salir a caminar", to: "n4wait", care: 10 }, { t: "Contárselo a alguien de confianza", to: "n4talk", care: 10 }] },
      n4wait: { npc: "Valeria", m: "calm", t: ["El impulso sube, llega a su máximo y baja. Dura unos pocos minutos.", "Lo cuentas en el reloj. Salvaste un vape."],
        fact: { h: "El antojo pasa solo", ctx: "Un antojo de nicotina dura pocos minutos.", fx: "Cada vez que lo dejas pasar, pierde fuerza.", more: "Un antojo de nicotina suele durar pocos minutos. Cada vez que lo dejas pasar sin usar, pierde fuerza.", s: "CDC" },
        end: { k: "good", h: "El impulso pasó. Tú te quedaste", real: ["Esperar no es debilidad: es la técnica que mejor funciona.", "Cada antojo que dejas pasar quita fuerza al siguiente."], tip: "Cuando llegue el próximo, pon un reloj de cinco minutos y camina." } },
      n4talk: { npc: "Camilo", m: "calm", t: ["Se lo dices a Camilo. No te regaña: «A mí me pasó con cigarros.»", "Te ayuda a armar un plan: caminar, avisar, pedir ayuda profesional si hace falta."],
        end: { k: "good", h: "Contarlo lo desarma", real: ["Lo que se cuenta en voz alta pesa menos.", "Pedir ayuda a alguien cercano es el primer paso más fácil."], tip: "Si sientes que no puedes solo, IAFA: 800-IAFA-800." } },
      n4hook: { npc: "Valeria", m: "worried", t: ["Un mes. Despiertas pensando en el vape.", "En clase no escuchas: calculas cuándo sales. Si pasan horas sin usarlo, estás irritable y ansioso.", "Ya no lo usas para sentirte bien. Lo usas para dejar de sentirte mal."], d: { foco: -2, animo: -2, sueno: -1, corazon: -1 },
        fact: { h: "La dependencia es real", ctx: "La nicotina crea dependencia, y el cerebro madura hasta cerca de los 25.", fx: "Sin ella llegan irritabilidad, ansiedad y mala concentración. Mejora en días.", more: "La nicotina causa dependencia física y psicológica. El cerebro sigue madurando hasta cerca de los 25 años y el uso de nicotina puede afectar atención y aprendizaje. Al dejarla aparecen irritabilidad, ansiedad y mala concentración, que mejoran con los días.", s: "CDC, NIDA" },
        c: [{ t: "Dejarlo de golpe, sin plan", to: "n5relapse", care: 5 }, { t: "Pedir ayuda: servicio de salud o IAFA", to: "n5help", care: 10 }, { t: "Seguir como estás", to: "endbad", care: 0 }] },
      n5relapse: { npc: "Camilo", m: "worried", t: ["Día dos. Irritable, durmiendo mal, peleas por tonterías.", "Es abstinencia: incomoda y es temporal. Pero sin plan, es lo que más empuja a recaer."], d: { animo: -1, sueno: -1 },
        c: [{ t: "Resistir con plan: caminar, agua, avisar a alguien", to: "endgood2", care: 10 }, { t: "Volver al vape para que pase", to: "endok", care: 0 }] },
      n5help: { npc: "Camilo", m: "proud", t: ["Te orientan, te dan un plan y apoyo si lo necesitas.", "No es ir a encerrarte a ningún lado: es una conversación y un plan."],
        end: { k: "good", h: "Pedir ayuda no es rendirse", real: ["Con apoyo, dejarlo es más probable que sin él.", "IAFA: 800-IAFA-800."], tip: "Guarda ese número aunque nunca lo uses." } },
      endbad: { npc: "Valeria", m: "worried", t: ["Pasan los meses. Cada vez cuesta más y todo gira alrededor del próximo."],
        end: { k: "bad", h: "Ahora manda el vape", real: ["La dependencia no se nota hasta que quieres parar.", "Lo bueno: casi siempre se puede salir, sobre todo con ayuda."], tip: "Hoy sigue siendo un buen día para pedir ayuda." } },
      endok: { npc: "Camilo", m: "calm", t: ["Se te pasa la angustia. Vuelve el ciclo."],
        end: { k: "ok", h: "Un día más, el ciclo sigue", real: ["Una recaída es información, no un fracaso.", "Lo que cambia las cosas es volver a intentarlo con plan."], tip: "La próxima, avisa a alguien antes de que empiece el día difícil." } },
      endgood2: { npc: "Camilo", m: "proud", t: ["El día tres sigue incómodo. El cuatro, menos. El siete, otra cosa."],
        end: { k: "good", h: "Salir toma días, no años", real: ["Los síntomas fuertes de dejar la nicotina suelen mejorar en pocos días.", "Con plan, el cuerpo vuelve a funcionar sin el vape."], tip: "Si pasan semanas y no mejora, pide apoyo profesional." } },
    },
  },

  /* ---------------------------------------------------------------- 4 */
  {
    id: "pastillas", jump: { n3: { corazon: -2, animo: -1, sueno: -2, juicio: -1 } }, npc0: "Rafa",  title: "Pastillas de estudio", tag: "estimulantes", icon: "ph-pill", color: "teal",
    hook: "Una pastilla de otro, una noche, ocho horas de rendimiento. ¿Cuánto se paga?",
    story: "Semana de finales. Biblioteca, 1 de la madrugada. Rafa tiene medicamento de su hermano y dice que cualquiera rinde más.",
    cast: [["Rafa", "tu compañero de carrera"], ["Lucía", "tu vecina de residencia"]],
    stats: ["corazon", "sueno", "animo", "foco", "juicio"],
    start: "n1", guide: "estimulantes",
    scenes: [["La biblioteca", "n1"], ["Las 4 de la mañana", "n3"]],
    nodes: {
      n1: { npc: "Rafa", m: "happy", o: [{"k": "pastilla", "ic": "ph-pill", "l": "La pastilla", "ctx": "Recetada para otra persona.", "fx": "Tu cuerpo no es el suyo: no sabes cómo reaccionará."}, {"k": "cafe", "ic": "ph-coffee", "l": "El café", "ctx": "Es el tercero de la noche.", "fx": "Más cafeína suma pulso y quita sueño."}], t: ["Semana de finales. Biblioteca, 1 de la madrugada, tercer café.", "Rafa: «Tengo pastillas de mi hermano, las usa para el TDAH. Una y rindes ocho horas.»", "Es una pastilla, no parece gran cosa. Y lo que importa es aprobar."],
        c: [{ t: "Tomarla", to: "n2take", care: 0 }, { t: "Preguntar qué es y quién la recetó", to: "n2ask", care: 5 }, { t: "No tomarla y seguir a tu manera", to: "n2no", care: 10 }] },
      n2ask: { npc: "Rafa", m: "calm", t: ["Rafa: «Es de mi hermano. A él le funciona, a ti ni idea.»", "Una pastilla de otra persona no sabe quién eres: tu corazón, tus medicinas, tu ansiedad."],
        fact: { h: "Recetada para otro no es segura para ti", ctx: "Estos medicamentos se recetan tras evaluar a cada persona.", fx: "Sin evaluación pueden subir el pulso y dar insomnio. Muchas pastillas sin receta son falsas.", more: "Estos medicamentos se recetan tras evaluar a cada persona. Sin esa evaluación pueden subir el pulso y la presión, causar ansiedad e insomnio. Además, muchas pastillas que circulan sin receta son falsificadas y su contenido es incierto.", s: "NIDA" },
        c: [{ t: "Tomarla igual", to: "n2take", care: 0 }, { t: "Decir que no", to: "n2no", care: 10 }] },
      n2take: { npc: "Rafa", m: "happy", t: ["A los 40 minutos: corazón rápido, manos inquietas, mente prendida.", "Te sientes productivo. Lees más páginas... y te cuesta recordar cuáles.", "No tienes hambre y te tiemblan un poco las manos."], d: { corazon: -2, animo: -1, sueno: -2, juicio: -1 },
        fact: { h: "Te sientes más listo, no necesariamente lo eres", ctx: "Sin TDAH, el beneficio para estudiar es pequeño o poco claro.", fx: "Sientes más alerta y rindes parecido, con pulso alto y sueño roto.", more: "En personas sin TDAH, el beneficio académico de estos medicamentos es pequeño o poco claro, aunque suben la sensación de alerta y motivación. Los efectos incluyen pulso y presión más altos, ansiedad y mal sueño.", s: "NIDA" }, go: "n3" },
      n3: { npc: "Rafa", m: "tired", o: [{"k": "reloj", "ic": "ph-alarm", "l": "El reloj", "ctx": "Son las 4 y el examen es a las 8.", "fx": "Dormir aunque sea poco ayuda más que otra pastilla."}], t: ["4 am. Los ojos abiertos de par en par. El examen es a las 8.", "El cuerpo está cansado; la cabeza no se apaga. El corazón va rápido."],
        c: [{ t: "Tomar otra para aguantar", to: "n4bad", care: 0 }, { t: "Acostarte aunque no duermas", to: "n4rest", care: 5 }, { t: "Avisar a Lucía y consultar a salud", to: "n4help", care: 10 }] },
      n4bad: { npc: "Lucía", m: "scared", t: ["Pulso fuerte, temblor, el pecho oprimido.", "Sientes que algo no va bien. Y no te equivocas."], d: { corazon: -2, animo: -2 },
        fact: { h: "Cuando el cuerpo avisa, hay que escucharlo", ctx: "Dolor de pecho, latidos muy irregulares o confusión son señales de emergencia.", fx: "Se llama al 911. No se espera a que pase.", more: "Dolor de pecho, latidos muy rápidos o irregulares, convulsiones o confusión intensa son señales de emergencia: se llama al 911.", s: "NIDA" },
        c: [{ t: "Llamar al 911 y avisar a alguien", to: "endcall", care: 10 }, { t: "Esperar a que pase", to: "endbad", care: 0 }] },
      n4rest: { npc: "Rafa", m: "tired", t: ["Das vueltas dos horas. Duermes media.", "Llegas al examen exhausto y con el corazón raro."], d: { sueno: -1 },
        end: { k: "ok", h: "Evitaste lo peor, no la noche", real: ["Dormir poco igual perjudica atención y memoria.", "Lo que ya sabías valía más que cualquier pastilla."], tip: "Con pastilla o sin ella, la memoria necesita dormir." } },
      n4help: { npc: "Lucía", m: "calm", t: ["Lucía llama al servicio de salud de la universidad. Te toman el pulso, te hablan y te dicen qué hacer.", "Te dejan en reposo, sin café y sin otra pastilla."],
        end: { k: "good", h: "Pedir ayuda a tiempo", real: ["Contar lo que tomaste permite que te cuiden bien.", "Hay gente cuyo trabajo es ayudarte con esto, sin juzgarte."], tip: "Si algo se siente raro, avisar antes siempre sale mejor." } },
      endcall: { npc: "Lucía", m: "worried", t: ["Dices qué tomaste y cuándo. Te dicen cómo esperar la ayuda."],
        end: { k: "good", h: "Llamar a tiempo", real: ["A emergencias le importa cuidarte, no regañarte.", "Dolor de pecho y latidos irregulares son motivo suficiente para llamar."], tip: "Guarda el 911 aunque creas que no lo necesitas." } },
      endbad: { npc: "Lucía", m: "scared", t: ["Esperas. El malestar crece. El examen ya no importa."],
        end: { k: "bad", h: "Aguantar no era la opción", real: ["Dolor de pecho o latidos muy irregulares no se aguantan: se avisan.", "Esperar a que pase es lo que más se arrepiente después."], tip: "Ante cualquier señal de pecho o confusión, llama primero." } },
      n2no: { npc: "Rafa", m: "calm", t: ["Rafa: «Tú sabrás.» Te quedas con tu plan: bloques de 45 minutos, 5 de pausa, y dormir cinco horas.", "No es mágico. Pero te acuerdas de lo que estudiaste."],
        end: { k: "good", h: "Sin atajos, con memoria", real: ["Estudiar en bloques y dormir rinde más que una pastilla prestada.", "Una pastilla de otro es una apuesta con tu cuerpo, no un atajo."], tip: "Si te cuesta concentrarte seguido, consulta con salud: puede haber una causa real." } },
    },
  },

