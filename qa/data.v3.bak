};

window.CASES = [
  /* ---------------------------------------------------------------- 1 */
  {
    id: "llaves", jump: { n3: { juicio: -1 } }, npc0: "Andrés",  title: "Las llaves de Andrés", tag: "alcohol", icon: "ph-car-profile", color: "coral",
    hook: "Dice que está perfecto para manejar. Tú decides si le crees.",
    story: "Cumpleaños de Dani. Llegaste con Andrés, que es quien maneja. A las 2 de la mañana, las llaves siguen en su mano.",
    cast: [["Andrés", "tu amigo, el que maneja"], ["Sofi", "viene contigo"], ["Dani", "la cumpleañera"]],
    stats: ["juicio", "reflejos", "foco", "memoria", "animo"],
    start: "n1", guide: "alcohol",
    scenes: [["La fiesta", "n1"], ["Las 2 de la mañana", "n3"], ["Al día siguiente", "n5"]],
    nodes: {
      n1: { npc: "Andrés", m: "happy", o: [{"k": "vaso", "ic": "ph-wine", "l": "El vaso", "ctx": "Un trago no es un vaso: depende de qué y cuánto te sirvan.", "fx": "Contar vasos no sirve si no sabes qué hay dentro."}], t: ["Cumpleaños de Dani. Son las 10 de la noche y la música no deja hablar normal.", "Llegaste en el carro de Andrés. Quedaron en que él maneja de regreso y casi no toma.", "Andrés: «Toma, {yo}, ya te serví uno. No seas aburrido.»"],
        c: [{ t: "Tomarlo despacio y alternar con agua", to: "n2a", care: 5 }, { t: "Seguirle el ritmo a Andrés", to: "n2b", care: 0 }, { t: "Decir que no y pedir agua", to: "n2c", care: 10 }] },
      n2a: { npc: "Andrés", m: "happy", t: ["Pasan dos horas. Bailas, hablas, tomas agua entre trago y trago.", "Te sientes bien. Y ahí está la trampa: sentirte bien no es estar sobrio."], d: { juicio: -1 },
        fact: { h: "El juicio se apaga primero", ctx: "El alcohol frena la zona del cerebro que mide riesgos, antes de que te sientas borracho.", fx: "Sientes que estás bien. Tu juicio ya no lo está.", more: "El alcohol frena las zonas del cerebro que calculan riesgos antes de que sientas que estás borracho. Por eso casi todo el mundo cree que está bien para manejar.", s: "NIAAA" }, go: "n3" },
      n2b: { npc: "Andrés", m: "tipsy", t: ["Segunda ronda. Tercera. Ya te ríes de todo.", "Andrés también le sigue el ritmo, y nadie está contando sus tragos.", "Tus reflejos van más lentos que tú, aunque no lo notes."], d: { juicio: -2, reflejos: -1, foco: -1, memoria: -1 },
        fact: { h: "Qué le hace el alcohol al cuerpo", ctx: "Es un depresor: ralentiza la comunicación entre neuronas.", fx: "Reflejos, equilibrio y memoria empeoran. Pueden aparecer lagunas.", more: "El alcohol es un depresor: ralentiza la comunicación entre neuronas. Empeora equilibrio, reacción y memoria. Con mucho alcohol aparecen lagunas: horas que tu cerebro nunca guardó.", s: "NIAAA" }, go: "n3" },
      n2c: { npc: "Dani", m: "calm", t: ["Dani te mira un segundo y sigue. Nadie lo hace tema.", "Otra amiga pide agua también. Te ríes igual, con el cerebro completo."], go: "n3" },
      n3: { npc: "Andrés", m: "tipsy", o: [{"k": "llaves", "ic": "ph-key", "l": "Las llaves", "ctx": "Quien tiene las llaves decide por todos.", "fx": "Pedirlas incomoda diez segundos. No es una pelea."}, {"k": "celu", "ic": "ph-device-mobile", "l": "Tu celular", "ctx": "Una app de transporte llega en minutos.", "fx": "Doce minutos de espera valen más que un trayecto dudoso."}], t: ["Son las 2. Andrés tiene los ojos pesados y las llaves en la mano.", "Andrés: «Yo los llevo. Estoy perfecto, es cerca.»", "Sofi ya se está subiendo al asiento de atrás."],
        c: [{ t: "Subirte: él dice que está bien", to: "n4crash", care: 0 }, { t: "Pedir un taxi o app para Sofi y para ti", to: "n4taxi", care: 10 }, { t: "Pedirle las llaves, con Dani de apoyo", to: "n4keys", care: 10 }, { t: "Manejar tú (tomaste, pero menos que él)", to: "n4you", care: 0 }] },
      n4crash: { npc: "Sofi", m: "hurt", t: ["Andrés toma la curva un poco ancha. Su freno llega un segundo tarde.", "A 60 km/h, un segundo son casi 17 metros recorridos sin reaccionar.", "Choque contra el muro. Sofi se golpea la cabeza. Todos salen vivos. Esta vez."], d: { reflejos: -1 },
        fact: { h: "Por qué un segundo pesa tanto", ctx: "Con alcohol, el cerebro tarda más en reaccionar.", fx: "A 60 km/h, ese retraso son metros sin frenar.", more: "Con alcohol, el cerebro tarda más en reaccionar. Conducir con alcohol aumenta mucho el riesgo de choque, y el riesgo empieza antes del límite legal.", s: "NIAAA, CDC" },
        end: { k: "bad", h: "El segundo que faltó", real: ["Subirte con alguien que bebió es la decisión más peligrosa de la noche.", "Andrés no mentía: de verdad se sentía bien. Ese es justo el problema."], tip: "Si dudas de quién maneja, la respuesta es transporte seguro o quedarte a dormir." } },
      n4you: { npc: "Andrés", m: "worried", t: ["Piensas: yo estoy mejor que él. Es cierto. No es lo mismo que estar sobrio.", "Calculas mal una distancia al frenar y rozas el carro de adelante.", "Nadie se lastima. Un golpe, un reclamo y un seguro que explicar."], d: { reflejos: -1, juicio: -1 },
        fact: { h: "Menos borracho no es sobrio", ctx: "El alcohol afecta atención y reacción aunque te sientas bien.", fx: "No puedes medirte por cómo te sientes. Si bebiste, no manejas.", more: "Con alcohol en la sangre ya hay peor atención y reacción, aunque te sientas bien. No hay forma de medirte por cómo te sientes.", s: "NIAAA" },
        end: { k: "bad", h: "Menos borracho, igual de arriesgado", real: ["Tomar menos que otro no te vuelve sobrio.", "Esta vez fue un roce. Pudo no serlo."], tip: "Si bebiste, no manejas. Ni poquito, ni cerca." } },
      n4taxi: { npc: "Andrés", m: "angry", t: ["Andrés protesta: «Exageras.» Dani le saca las llaves esa noche.", "Tú y Sofi esperan el carro doce minutos. A las 2:40 estás en tu cama."], go: "n5" },
      n4keys: { npc: "Andrés", m: "angry", t: ["Es incómodo. Andrés se enoja diez segundos.", "Dani lo apoya: «Duérmete aquí, mañana buscas el carro.» Se queda en el sofá y asunto resuelto."], go: "n5" },
      n5: { npc: "Andrés", m: "tired", o: [{"k": "agua", "ic": "ph-drop", "l": "El agua", "ctx": "El alcohol deshidrata.", "fx": "Agua y comida ayudan al cuerpo. El café no sobria."}], t: ["Despiertas con la boca seca, un dolor de cabeza sordo y partes de la noche en blanco.", "Tienes que ir al trabajo y el carro sigue en la casa de Dani."], d: { foco: -1, memoria: -1, animo: -1 },
        fact: { h: "La resaca es tu cuerpo, no un castigo", ctx: "Deshidratación, sueño roto e inflamación.", fx: "El café despierta, no sobria. Solo el tiempo elimina el alcohol.", more: "Deshidratación, sueño roto e inflamación explican el malestar. Nada acelera la eliminación del alcohol: el hígado la procesa a su ritmo. El café te despierta, no te sobria.", s: "NIAAA" },
        c: [{ t: "Café y a manejar al trabajo", to: "endok", care: 0 }, { t: "Agua, comida y pedir que te lleven", to: "endgood", care: 10 }] },
      endok: { npc: "Andrés", m: "tired", t: ["Llegas al trabajo. Funcionas, más o menos."], end: { k: "ok", h: "Despierto, pero no del todo", real: ["Si bebiste bastante, todavía puedes tener alcohol en la sangre por la mañana.", "El café da energía. No devuelve reflejos."], tip: "Después de una noche pesada, pide que te lleven o espera unas horas." } },
      endgood: { npc: "Dani", m: "proud", t: ["Comes algo, tomas agua, vuelves a dormir un rato. Tu hermana te lleva."], end: { k: "good", h: "Bien a las 2 y bien a las 10", real: ["Elegiste bien en la noche y también en la mañana.", "El cuerpo no pide castigo: pide agua, comida y horas."], tip: "Anota esto: la mejor decisión de esa noche costó 12 minutos de espera." } },
    },
  },

