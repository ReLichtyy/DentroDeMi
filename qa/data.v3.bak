  {
    id: "sofi", jump: { n3: { aire: -2, conciencia: -2 } }, npc0: "Sofi", fixedNpc: "Sofi", owner: "npc",  title: "Alguien no responde", tag: "mezclas", icon: "ph-phone-call", color: "ink",
    hook: "Sofi se quedó dormida en el sofá. No parece sueño normal.",
    story: "Reunión en casa de Dani. Sofi tomó toda la noche y se tomó además algo que le dieron para relajarse. Ahora no contesta.",
    cast: [["Sofi", "tu amiga"], ["Dani", "el anfitrión"]],
    stats: ["aire", "conciencia", "corazon"],
    start: "n1", guide: "mezclas",
    scenes: [["La reunión", "n1"], ["El momento", "n3"]],
    nodes: {
      n1: { npc: "Sofi", m: "sleepy", o: [{"k": "pastilla", "ic": "ph-pill", "l": "La pastilla", "ctx": "Dani se la dio sin decir qué era.", "fx": "Nadie sabe qué contiene ni cómo se suma al alcohol."}, {"k": "vaso", "ic": "ph-wine", "l": "Su vaso", "ctx": "Sofi tomó toda la noche.", "fx": "El alcohol solo ya baja la respiración si es mucho."}], t: ["Reunión en casa de Dani. Sofi tomó toda la noche, y Dani le dio algo para relajarse.", "Ahora está en el sofá, muy dormida. No contesta cuando le hablas suave."], d: { conciencia: -1 },
        c: [{ t: "Dejarla dormir, mañana se le pasa", to: "n2sleep", care: 0 }, { t: "Hablarle fuerte, sacudirla y ver cómo respira", to: "n2check", care: 10 }, { t: "Darle café y mandarla a la ducha fría", to: "n2coffee", care: 0 }] },
      n2sleep: { npc: "Sofi", m: "sleepy", t: ["Pasa media hora. Alguien le pone una cobija.", "Ahora respira lento, con pausas largas. Los labios se ven pálidos."], d: { aire: -2, conciencia: -2 }, go: "n3" },
      n2coffee: { npc: "Sofi", m: "sleepy", t: ["Se atraganta con el café y casi no reacciona al agua fría.", "El café no la sobria y la ducha no ayuda. Lo único que cambia: ahora puede vomitar estando dormida."], d: { aire: -1, conciencia: -1 },
        fact: { h: "Café y ducha: mitos que retrasan la ayuda", ctx: "Nada sobria a alguien salvo el tiempo.", fx: "Café y ducha no ayudan, y retrasan la llamada.", more: "Nada sobria a alguien salvo el tiempo. El café y las duchas no reducen la intoxicación y pueden retrasar la ayuda.", s: "NIAAA" }, go: "n3" },
      n2check: { npc: "Sofi", m: "sleepy", t: ["La llamas por su nombre, fuerte. La sacudes del hombro. Casi no responde.", "Escuchas: respira lento. No es sueño normal."], d: { aire: -1, conciencia: -2 },
        fact: { h: "Cómo distinguir sueño de emergencia", ctx: "Mira la respiración y si despierta.", fx: "Si no despierta, o respira lento o con pausas, es emergencia.", more: "Señales de emergencia: no despierta, respiración muy lenta o irregular, labios o piel pálidos o azulados, vómito estando inconsciente, convulsiones.", s: "NIAAA" }, go: "n3" },
      n3: { npc: "Sofi", m: "out", o: [{"k": "labios", "ic": "ph-eye", "l": "Sus labios", "ctx": "Se ven pálidos.", "fx": "Es falta de oxígeno: señal de emergencia."}, {"k": "tel", "ic": "ph-phone", "l": "El teléfono", "ctx": "El 911 atiende las 24 horas.", "fx": "Decir qué tomó ayuda a tratarla mejor."}], t: ["Sofi respira lento, con pausas largas. Labios pálidos. No reacciona.", "Dani: «Se va a pasar. Si llamamos nos meten en problemas.»"],
        c: [{ t: "Llamar al 911 ya y quedarte con ella", to: "n4call", care: 10 }, { t: "Pedir a alguien que llame mientras la pones de lado", to: "n4call", care: 10 }, { t: "Esperar diez minutos más a ver", to: "n4wait", care: 0 }, { t: "Llevarla tú en carro", to: "n4car", care: 0 }] },
      n4call: { npc: "Sofi", m: "sleepy", t: ["La operadora pregunta si respira y qué tomó. Dices la verdad: alcohol y una pastilla que no sabes qué es.", "La pones de lado, con la vía aérea despejada, sin dejarla sola.", "La ambulancia llega. Te dicen: «Hiciste lo correcto.»"], d: { aire: 2, conciencia: 1 },
        fact: { h: "Qué hacer mientras llega la ayuda", ctx: "Alcohol con sedantes puede frenar la respiración.", fx: "Llama al 911, ponla de lado, no la dejes sola y di qué tomó.", more: "Llama al 911, no la dejes sola, ponla de lado para que no se ahogue si vomita y cuéntales a los paramédicos qué tomó. A emergencias le importa tratarla bien, no regañarte.", s: "NIAAA" },
        end: { k: "good", h: "Una llamada cambió la noche", real: ["Alcohol junto con sedantes o similares puede frenar la respiración. Eso es lo que hace peligrosa la mezcla.", "Decir la verdad a emergencias ayuda a tratar mejor."], tip: "Ante respiración lenta o falta de respuesta, se llama primero y se discute después." } },
      n4wait: { npc: "Sofi", m: "out", t: ["Diez minutos. Las pausas se alargan. Ahora sí llamas, con miedo.", "La ambulancia llega rápido y se la llevan. Sofi queda en observación."], d: { aire: -1 },
        end: { k: "bad", h: "Diez minutos pesan", real: ["Si alguien respira lento y no responde, esperar es la peor opción: cada minuto cuenta.", "No sabes cómo termina por sí sola. No tenías por qué descubrirlo."], tip: "Llamar y que sea falsa alarma siempre es mejor que no llamar." } },
      n4car: { npc: "Sofi", m: "out", t: ["La cargan entre dos y arrancas. Estás nervioso y has tomado.", "Cada semáforo es un riesgo más; ella sigue sin responder."],
        end: { k: "bad", h: "Una ambulancia sí sabe qué hacer", real: ["Una persona inconsciente es mejor atendida por paramédicos que en un carro particular.", "Y si manejas después de beber, sumas otro riesgo."], tip: "Llama al 911: llevan equipo y saben cómo posicionarla." } },
    },
  },
];

/* Guía real: lo que de verdad pasa, sin rodeos. */
window.GUIDES = [
  { id: "alcohol", title: "Alcohol", icon: "ph-wine", src: "NIAAA, CDC", sections: [
    { h: "Lo que sientes", t: "Calor, desinhibición, ganas de hablar. Más tarde, lentitud, mareo y sueño." },
    { h: "Lo que pasa por dentro", t: "Es un depresor del sistema nervioso. Ralentiza reflejos, equilibrio y juicio, y con mucho alcohol también la respiración. El juicio se apaga antes de que sientas que estás borracho." },
    { h: "Mito y realidad", items: [["El café te sobria.", "No. Solo el tiempo. El café te despierta, no te devuelve reflejos."], ["Yo sé cuándo parar.", "El juicio es lo primero que falla, así que no es buen instrumento para medirte."], ["Comer antes evita la borrachera.", "Hace la absorción más lenta, no evita la intoxicación."]] },
    { h: "Es urgente si", t: "No despierta, respira lento o irregular, tiene piel pálida o azulada, convulsiona o vomita sin estar consciente. Llama al 911." },
    { h: "Qué ayuda", t: "Agua entre trago y trago, comer, decidir antes de salir quién no bebe, y transporte seguro." },
  ] },
  { id: "cannabis", title: "Cannabis", icon: "ph-leaf", src: "NIDA, CDC", sections: [
    { h: "Lo que sientes", t: "Relajación, hambre, risa, tiempo lento. Algunas personas sienten ansiedad o paranoia." },
    { h: "Lo que pasa por dentro", t: "El THC actúa donde se forman recuerdos y se sostiene la atención. Mientras dura, concentrarte y guardar información nueva cuesta más; también suben el pulso y los reflejos van más lentos. Fumado se siente en minutos y dura horas; los comestibles tardan más y duran más." },
    { h: "Mito y realidad", items: [["Te ayuda a estudiar.", "Lo contrario: durante el efecto, lo que estudias se guarda peor."], ["No engancha.", "Alrededor de 3 de cada 10 personas que lo usan desarrollan algún trastorno por consumo."], ["Es natural, entonces es seguro.", "Natural no significa inofensivo. Dosis altas pueden dar pánico y vómitos."]] },
    { h: "Es urgente si", t: "El pánico no cede, hay dolor de pecho, confusión intensa o vómitos que no paran." },
    { h: "Qué ayuda", t: "Un lugar tranquilo, agua, compañía y respirar lento. No manejar." },
  ] },
  { id: "vapeo", title: "Vapeo y nicotina", icon: "ph-cloud", src: "CDC, NIDA", sections: [
    { h: "Lo que sientes", t: "Una calma corta, un mareo leve, el corazón un poco más rápido. Dura poco, y por eso pide otro." },
    { h: "Lo que pasa por dentro", t: "La nicotina activa el sistema de recompensa del cerebro en segundos. Con el uso repetido aparece dependencia: antojos, irritabilidad, ansiedad y mala concentración cuando no la usas. El cerebro sigue madurando hasta cerca de los 25." },
    { h: "Mito y realidad", items: [["Solo es vapor.", "El aerosol contiene otras sustancias además de nicotina y varía según el producto."], ["Lo dejo cuando quiera.", "La dependencia llega rápido y dejarlo da síntomas reales, aunque temporales."], ["Sabe a fruta, no pasa nada.", "El sabor lo hace más fácil de repetir, no menos adictivo."]] },
    { h: "Es urgente si", t: "Tos intensa que no cede, falta de aire o dolor de pecho. Busca atención médica." },
    { h: "Qué ayuda", t: "Esperar cinco minutos (el antojo baja), moverte, avisar a alguien y pedir apoyo profesional. IAFA: 800-IAFA-800." },
  ] },
  { id: "estimulantes", title: "Estimulantes sin receta", icon: "ph-pill", src: "NIDA", sections: [
    { h: "Lo que sientes", t: "Energía, alerta, menos hambre, nerviosismo. Después, cansancio fuerte y ánimo bajo." },
    { h: "Lo que pasa por dentro", t: "Suben el pulso y la presión, y desordenan el sueño. En personas sin TDAH, el beneficio para estudiar es pequeño o poco claro, aunque da la sensación de rendir más." },
    { h: "Mito y realidad", items: [["Es un medicamento, así que es seguro.", "Es seguro con indicación y seguimiento médico. Sin ellos, no."], ["Me hace estudiar mejor.", "Te sientes más productivo. Memoria y aprendizaje no necesariamente mejoran."], ["La pastilla contiene lo que dice.", "Muchas pastillas sin receta son falsificadas; no sabes qué tomas."]] },
    { h: "Es urgente si", t: "Hay dolor de pecho, latidos muy rápidos o irregulares, convulsiones, fiebre alta o confusión intensa. Llama al 911." },
    { h: "Qué ayuda", t: "Dormir, estudiar en bloques, pedir apoyo académico y consultar a salud si te cuesta concentrarte seguido." },
  ] },
  { id: "mezclas", title: "Mezclas", icon: "ph-warning-diamond", src: "NIAAA, NIDA", sections: [
    { h: "Lo que sientes", t: "Es impredecible. Puede que no notes cuánto te afectó cada cosa." },
    { h: "Lo que pasa por dentro", t: "Alcohol con sedantes u opioides: ambos frenan la respiración. Alcohol con cannabis: más mareo, vómito y torpeza. Alcohol con estimulantes: sientes menos lo borracho que estás, y tiendes a beber más." },
    { h: "Mito y realidad", items: [["Una pastilla y un trago no es nada.", "Depende de cuál pastilla; con sedantes, puede ser lo que más peligra."], ["Si se duerme, se le pasa.", "Si respira lento o no despierta, no es sueño: es emergencia."], ["Café y ducha fría ayudan.", "No. Retrasan la ayuda."]] },
    { h: "Es urgente si", t: "No despierta, respira lento o con pausas largas, labios o piel pálidos o azulados, vómito estando inconsciente. Llama al 911." },
    { h: "Qué ayuda", t: "Llamar al 911, no dejarla sola, ponerla de lado, decirle a paramédicos qué tomó. No inducir el vómito." },
  ] },
];

